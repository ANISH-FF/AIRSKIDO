<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>AirSkid - Sky Track Smash Racer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Fredoka:wght@600;700;800&family=Space+Grotesk:wght@600;700&family=Teko:wght@700&family=Rajdhani:wght@700;800;900&display=swap" rel="stylesheet">
  <style>
    /* ================================================================
       BRUTOPIA // NEO-BRUTALIST MARIO YELLOW DESIGN SYSTEM
       ================================================================ */
    :root {
      --brut-yellow: #FFDE59;
      --brut-yellow-dark: #F59E0B;
      --brut-black: #000000;
      --brut-white: #FFFFFF;
      --brut-cream: #FFFDF5;
      --brut-red: #FF385C;
      --brut-green: #10B981;
      --brut-cyan: #00D2FF;
      --brut-purple: #A855F7;
      --brut-gray: #E5E7EB;
      --brut-border: 3.5px solid #000000;
      --brut-shadow: 5px 5px 0px #000000;
      --brut-shadow-lg: 8px 8px 0px #000000;
      --brut-shadow-sm: 3px 3px 0px #000000;
      --font-display: 'Fredoka', 'Bungee', cursive, sans-serif;
      --font-telemetry: 'Rajdhani', 'Space Grotesk', sans-serif;
      --font-digital: 'Teko', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
      outline: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--brut-yellow);
      font-family: var(--font-telemetry);
      touch-action: none;
    }

    #game-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: block;
      z-index: 1;
    }

    /* ── CHUNKY NEO-BRUTALIST BUTTONS ── */
    .brut-btn {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--brut-black);
      background: var(--brut-yellow);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 12px;
      padding: 10px 20px;
      cursor: pointer;
      transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.15s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .brut-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0px #000000;
    }
    .brut-btn:active {
      transform: translate(3px, 3px);
      box-shadow: 2px 2px 0px #000000;
    }
    .brut-btn.btn-red {
      background: var(--brut-red);
      color: #fff;
    }
    .brut-btn.btn-green {
      background: var(--brut-green);
      color: #fff;
    }
    .brut-btn.btn-cyan {
      background: var(--brut-cyan);
      color: #000;
    }
    .brut-btn.btn-white {
      background: var(--brut-white);
      color: #000;
    }

    /* ── TOP AUDIO & MULTIPLAYER STATUS BAR ── */
    #top-bar {
      position: absolute;
      top: 16px;
      right: 170px;
      display: flex;
      gap: 10px;
      z-index: 25;
      pointer-events: auto;
    }
    #sound-toggle, #fullscreen-btn {
      font-size: 13px;
      padding: 6px 14px;
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 10px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.1s ease;
    }
    #sound-toggle:active, #fullscreen-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000;
    }
    #room-badge {
      display: none;
      font-size: 13px;
      padding: 6px 14px;
      background: var(--brut-yellow);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 10px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* ── IN-GAME BRUTOPIA HUD ── */
    #hud-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
      display: none;
    }

    /* Top Left: Position & Laps */
    .top-left-hud {
      position: absolute;
      top: 16px;
      left: 20px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .pos-badge {
      background: var(--brut-yellow);
      color: var(--brut-black);
      padding: 6px 16px;
      border-radius: 14px;
      font-family: var(--font-display);
      font-size: 34px;
      font-weight: 800;
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      line-height: 1;
      transform: rotate(-2deg);
    }

    .lap-box {
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 12px;
      padding: 6px 14px;
      color: var(--brut-black);
    }
    .lap-title {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #666;
    }
    .lap-num {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 800;
      line-height: 1.1;
      color: var(--brut-black);
    }

    /* Top Right: Minimap */
    .top-right-hud {
      position: absolute;
      top: 16px;
      right: 20px;
    }

    .minimap-card {
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 18px;
      padding: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .minimap-title {
      font-family: var(--font-display);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--brut-black);
      text-transform: uppercase;
      text-align: center;
      width: 100%;
    }

    #minimap-canvas {
      width: 130px;
      height: 130px;
      background: #0d121c;
      border-radius: 12px;
      border: 2.5px solid #000;
      display: block;
    }

    /* ── LIVE STANDINGS & LAPS CARD ── */
    .live-standings-card {
      position: absolute;
      top: 86px;
      left: 20px;
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 14px;
      padding: 6px 10px;
      min-width: 175px;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .standings-title {
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #666;
      text-transform: uppercase;
      border-bottom: 1.5px solid #eee;
      padding-bottom: 2px;
    }
    .standings-list {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .standing-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 12px;
      font-weight: 800;
      padding: 2px 5px;
      border-radius: 6px;
      background: #f7f7f7;
    }
    .standing-row.is-player {
      background: var(--brut-yellow);
      color: #000;
      box-shadow: 1px 1px 0px #000;
    }
    .standing-row.is-spectated {
      outline: 2px solid #00f0ff;
    }
    .standing-rank-badge {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      min-width: 16px;
    }
    .standing-name-text {
      flex: 1;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 82px;
    }
    .standing-lap-tag {
      font-family: var(--font-display);
      font-size: 10.5px;
      font-weight: 900;
      padding: 1px 5px;
      background: #000;
      color: #fff;
      border-radius: 4px;
    }
    .standing-lap-tag.finished {
      background: #00D26A;
      color: #000;
    }
    .standing-lap-tag.final-lap {
      background: #FF385C;
      color: #fff;
    }

    /* ── FINISH COUNTDOWN BANNER ── */
    #finish-countdown-banner {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: #FF385C;
      color: #fff;
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 24px;
      padding: 6px 18px;
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 900;
      letter-spacing: 1px;
      display: none;
      align-items: center;
      gap: 8px;
      z-index: 35;
      animation: finishPulse 1.0s infinite alternate ease-in-out;
    }
    @keyframes finishPulse {
      0% { transform: translateX(-50%) scale(0.97); }
      100% { transform: translateX(-50%) scale(1.03); }
    }

    /* ── SPECTATOR MODE OVERLAY ── */
    #spectator-overlay {
      position: absolute;
      bottom: 95px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(13, 18, 28, 0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 18px;
      padding: 8px 16px;
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      z-index: 40;
      pointer-events: auto;
    }
    .spectator-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      color: #fff;
      letter-spacing: 1px;
    }
    .spectator-live-dot {
      color: #ff3366;
      font-size: 16px;
      animation: liveBlink 1s infinite alternate;
    }
    @keyframes liveBlink {
      0% { opacity: 0.3; }
      100% { opacity: 1.0; }
    }
    .spectator-pos-tag {
      background: var(--brut-yellow);
      color: #000;
      padding: 1px 6px;
      border-radius: 6px;
      font-size: 13px;
      border: 1.5px solid #000;
    }
    .spectator-controls {
      display: flex;
      gap: 8px;
    }
    .spectator-btn {
      background: var(--brut-white);
      color: #000;
      border: 2px solid #000;
      box-shadow: 2px 2px 0px #000;
      border-radius: 8px;
      padding: 4px 12px;
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.08s ease;
    }
    .spectator-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 0px 0px 0px #000;
    }

    /* Bottom Right: Neo-Brutalist Speedometer & Nitro HUD */
    .speedo-container {
      position: absolute;
      bottom: 24px;
      right: 24px;
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 18px;
      padding: 12px 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 175px;
    }

    .speedo-digits-col {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      width: 100%;
    }

    .speed-value {
      font-family: var(--font-digital);
      font-size: 64px;
      color: var(--brut-black);
      line-height: 0.85;
      letter-spacing: 1px;
    }
    .speed-unit {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 800;
      color: var(--brut-red);
      letter-spacing: 2px;
      margin-top: 2px;
    }

    .nitro-card {
      width: 100%;
      margin-top: 10px;
      padding-top: 8px;
      border-top: 2.5px solid #000;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .nitro-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      font-family: var(--font-display);
    }

    .nitro-card-title {
      font-size: 13px;
      font-weight: 900;
      color: #000;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .nitro-card-count {
      font-size: 13px;
      font-weight: 900;
      color: #000;
      background: #00f0ff;
      border: 1.5px solid #000;
      border-radius: 6px;
      padding: 1px 7px;
      letter-spacing: 0.5px;
      box-shadow: 1.5px 1.5px 0px #000;
    }

    .nitro-card-count.depleted {
      color: #777;
      background: #eee;
      box-shadow: none;
    }

    .nitro-card-hint {
      font-size: 10px;
      font-weight: 900;
      color: #222;
      background: #ffe600;
      border: 1.5px solid #000;
      border-radius: 5px;
      padding: 1px 5px;
      letter-spacing: 0.5px;
    }

    .nitro-pips-container {
      display: flex;
      gap: 6px;
      width: 100%;
      justify-content: center;
    }
    .nitro-pip {
      flex: 1;
      height: 10px;
      background: #2a2c38;
      border: 2px solid #000;
      border-radius: 5px;
      transition: background 0.15s ease, box-shadow 0.15s ease;
    }
    .nitro-pip.active {
      background: #00f0ff;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.85);
    }

    .nitro-bar-container {
      width: 100%;
      height: 8px;
      background: #1a1a22;
      border-radius: 5px;
      overflow: hidden;
      border: 1.5px solid #000;
    }
    .nitro-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #00f0ff, #ffe600);
      transition: width 0.08s linear;
    }

    /* Mobile Responsive Speedometer: Bottom-Center Dashboard Layout */
    @media (max-width: 950px), (max-height: 520px), (hover: none) and (pointer: coarse) {
      .speedo-container {
        position: absolute;
        bottom: 12px;
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        min-width: 125px;
        padding: 6px 14px;
        align-items: center;
        border-radius: 14px;
        background: rgba(255, 253, 245, 0.95);
        border: 3px solid #000;
        box-shadow: 4px 4px 0px #000;
        z-index: 15;
      }
      .speed-value {
        font-size: 42px;
        line-height: 0.85;
      }
      .speed-unit {
        font-size: 10px;
        letter-spacing: 1.5px;
        margin-top: 1px;
      }
      .nitro-bar-container {
        height: 10px;
        margin-top: 4px;
      }
    }

    /* ── PRO RACING LOADING SCREEN (SUNNY SKY ARCADE // YELLOW + WHITE + SKY BLUE) ── */
    #loading-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 50% 38%, #FFF9C4 0%, #FFDE59 45%, #F59E0B 85%, #D97706 100%);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.5s;
    }
    #loading-screen.fade-out {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .loader-card {
      background: #FFFDF5;
      border: 4px solid #000;
      box-shadow: 10px 10px 0px #000;
      border-radius: 28px;
      padding: 26px 32px;
      max-width: 520px;
      width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      position: relative;
      overflow: hidden;
    }
    .loader-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: linear-gradient(90deg, #FFDE59 0%, #00D2FF 50%, #FFDE59 100%);
    }
    .loader-logo-wrap {
      width: 100%;
      max-width: 440px;
      display: flex;
      justify-content: center;
    }
    .loader-logo-wrap svg {
      width: 100%;
      height: auto;
    }
    .loader-wheel-stage {
      position: relative;
      width: 140px;
      height: 140px;
      margin: 2px 0;
    }
    .loader-wheel-stage svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    @keyframes spinRacerWheel {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .spinning-rim {
      transform-origin: 100px 100px;
      animation: spinRacerWheel 0.65s linear infinite;
    }
    @keyframes smokeDriftLeft {
      0% { transform: translate(0, 0) scale(0.6); opacity: 0.7; }
      50% { opacity: 0.9; }
      100% { transform: translate(-30px, -14px) scale(1.6); opacity: 0; }
    }
    @keyframes smokeDriftRight {
      0% { transform: translate(0, 0) scale(0.6); opacity: 0.7; }
      50% { opacity: 0.9; }
      100% { transform: translate(30px, -14px) scale(1.6); opacity: 0; }
    }
    .smoke-puff-left {
      transform-origin: 85px 182px;
      animation: smokeDriftLeft 0.9s ease-out infinite;
    }
    .smoke-puff-right {
      transform-origin: 115px 182px;
      animation: smokeDriftRight 0.9s ease-out infinite 0.45s;
    }
    @keyframes sparkFlicker {
      0%, 100% { opacity: 0.2; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.2); }
    }
    .burnout-spark {
      animation: sparkFlicker 0.18s infinite alternate;
    }

    /* RPM Tachometer Rev Dashboard (Clean Arcade White & Yellow) */
    .loader-rpm-dashboard {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: #FFFFFF;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 14px;
      padding: 7px 14px;
      box-sizing: border-box;
    }
    .rpm-meter-cluster {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .rpm-label {
      font-family: var(--font-telemetry);
      font-size: 11px;
      font-weight: 900;
      color: #000;
      letter-spacing: 1px;
      margin-right: 4px;
    }
    .rpm-segment {
      width: 11px;
      height: 16px;
      background: #E2E8F0;
      border: 1px solid #CBD5E1;
      border-radius: 2px;
      transform: skewX(-15deg);
      transition: all 0.12s ease;
    }
    .rpm-segment.green.active {
      background: #10B981;
      border-color: #047857;
      box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
    }
    .rpm-segment.yellow.active {
      background: #FFDE59;
      border-color: #D97706;
      box-shadow: 0 0 6px rgba(255, 222, 89, 0.8);
    }
    .rpm-segment.red.active {
      background: #EF4444;
      border-color: #B91C1C;
      box-shadow: 0 0 8px rgba(239, 68, 68, 0.7);
    }
    .rpm-digital-val {
      font-family: var(--font-digital);
      font-size: 15px;
      font-weight: 900;
      color: #0284C7;
      letter-spacing: 1px;
    }
    .rpm-pct-val {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      color: #000;
      background: #FFDE59;
      border: 1.5px solid #000;
      border-radius: 6px;
      padding: 2px 8px;
      letter-spacing: 0.5px;
    }
    .loader-bar-bg {
      width: 100%;
      height: 16px;
      background: #FFFFFF;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 10px;
      overflow: hidden;
      margin-top: 2px;
      position: relative;
    }
    .loader-bar-fill {
      width: 15%;
      height: 100%;
      background: linear-gradient(90deg, #FFDE59 0%, #00D2FF 100%);
      border-right: 2px solid #000;
      transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .loader-status {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #0F172A;
      text-transform: uppercase;
    }
    .loader-tap-hint {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #000;
      background: #FFDE59;
      border: 2.5px solid #000;
      box-shadow: 3.5px 3.5px 0 #000;
      border-radius: 12px;
      padding: 7px 20px;
      cursor: pointer;
      transition: transform 0.08s ease;
    }
    .loader-tap-hint:active {
      transform: translate(2px, 2px);
      box-shadow: 1.5px 1.5px 0 #000;
    }

    /* Screen Notifications (Sleek, Unobtrusive Top Badge) */
    #alert-banner {
      position: absolute;
      top: 62px;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--brut-black);
      background: var(--brut-yellow);
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 12px;
      padding: 6px 20px;
      text-align: center;
      pointer-events: none;
      transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.25s;
      opacity: 0;
      z-index: 30;
      white-space: nowrap;
      max-width: 90vw;
    }
    #alert-banner.active {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    #alert-banner.smash {
      background: var(--brut-yellow);
      color: var(--brut-black);
    }
    #alert-banner.recoil {
      background: var(--brut-red);
      color: #fff;
    }
    #alert-banner.respawn {
      background: var(--brut-cyan);
      color: #000;
    }

    /* Countdown Overlay */
    #countdown-overlay {
      position: absolute;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-display);
      font-size: 140px;
      font-weight: 900;
      color: var(--brut-yellow);
      -webkit-text-stroke: 4px #000;
      text-shadow: 8px 8px 0px #000;
      display: none;
      z-index: 25;
      pointer-events: none;
    }

    /* Flashing Wrong-Way Warning Banner */
    #wrong-way-banner {
      position: absolute;
      top: 20%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #fff;
      background: var(--brut-red);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-lg);
      border-radius: 18px;
      padding: 12px 30px;
      display: none;
      z-index: 35;
      pointer-events: none;
      animation: wrongWayFlash 0.35s infinite alternate;
    }

    @keyframes wrongWayFlash {
      0% { transform: translate(-50%, -50%) scale(0.96); opacity: 0.95; }
      100% { transform: translate(-50%, -50%) scale(1.04); opacity: 1; background: #000; color: var(--brut-red); }
    }

    /* ── MOBILE TOUCH CONTROLS (NFS / Asphalt Mobile Arcade Style) ── */
    #touch-controls {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      display: none;
      z-index: 15;
    }

    /* Left Steering Cluster: ◀ LEFT and ▶ RIGHT */
    .touch-steer-cluster {
      position: absolute;
      bottom: 22px;
      left: 20px;
      display: flex;
      gap: 12px;
      align-items: center;
      pointer-events: auto;
      touch-action: none;
    }

    .touch-ctrl-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 900;
      border: 3.5px solid #000;
      box-shadow: 4px 4px 0px #000;
      touch-action: manipulation;
      transition: transform 0.06s ease, box-shadow 0.06s ease, filter 0.06s ease, background 0.06s ease;
      user-select: none;
      -webkit-user-select: none;
      cursor: pointer;
      pointer-events: auto;
    }
    .touch-ctrl-btn:active, .touch-ctrl-btn.pressed {
      transform: translate(3px, 3px) scale(0.96);
      box-shadow: 1px 1px 0px #000;
      filter: brightness(1.2);
    }

    /* Steering Buttons (Rounded Squares) */
    .btn-steer {
      width: 76px;
      height: 76px;
      border-radius: 18px;
      background: #FFFDF5;
      color: #000;
    }
    .btn-steer .ctrl-icon {
      font-size: 30px;
      line-height: 1;
    }
    .btn-steer .ctrl-sub {
      font-size: 10px;
      letter-spacing: 1px;
      margin-top: 2px;
      font-weight: 800;
      color: #333;
    }
    .btn-steer:active, .btn-steer.pressed {
      background: #FFDE59;
      color: #000;
      border-color: #000;
    }

    /* Right Action Cluster */
    .touch-action-cluster {
      position: absolute;
      bottom: 22px;
      right: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: flex-end;
      pointer-events: auto;
      touch-action: none;
    }

    .touch-top-action-row {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn-respawn {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: #FFFDF5;
      color: #000;
      font-size: 11px;
    }
    .btn-respawn .ctrl-icon-sm {
      font-size: 18px;
      line-height: 1;
    }
    .btn-respawn .ctrl-sub-sm {
      font-size: 8px;
      letter-spacing: 0.5px;
      font-weight: 800;
    }

    .btn-nitro, .btn-drift {
      width: 96px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, #00f0ff 0%, #00b4d8 100%);
      color: #000;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1px;
      flex-direction: row;
      gap: 6px;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.4), var(--brut-shadow);
      transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.15s;
    }
    .btn-nitro .ctrl-icon-sm, .btn-drift .ctrl-icon-sm {
      font-size: 16px;
      color: #ffe600;
    }
    .btn-nitro:active, .btn-nitro.pressed, .btn-drift:active, .btn-drift.pressed {
      background: linear-gradient(135deg, #ff0055 0%, #ff5500 100%);
      color: #fff;
      box-shadow: 0 0 14px rgba(255, 0, 85, 0.6), 2px 2px 0px #000;
      transform: translate(2px, 2px);
    }
    .btn-nitro.depleted {
      opacity: 0.4;
      filter: grayscale(0.8);
      box-shadow: 2px 2px 0px #000;
    }

    .touch-pedal-row {
      display: flex;
      gap: 12px;
      align-items: flex-end;
    }

    /* Square Brake Pedal */
    .btn-brake-square {
      width: 74px;
      height: 74px;
      border-radius: 18px;
      background: #FF385C;
      color: #fff;
    }
    .btn-brake-square .ctrl-icon {
      font-size: 22px;
      line-height: 1;
    }
    .btn-brake-square .ctrl-label {
      font-size: 11px;
      letter-spacing: 1px;
      margin-top: 2px;
    }
    .btn-brake-square:active, .btn-brake-square.pressed {
      background: #D90429;
    }

    /* Square Gas Pedal (NFS / Asphalt Style) */
    .btn-gas-square {
      width: 90px;
      height: 90px;
      border-radius: 20px;
      background: #00D26A;
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .btn-gas-square .ctrl-icon-gas {
      font-size: 28px;
      line-height: 0.9;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    .btn-gas-square .ctrl-label-gas {
      font-size: 14px;
      letter-spacing: 1.5px;
      font-weight: 900;
      text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    }
    .gas-pedal-grooves {
      display: flex;
      gap: 4px;
      margin-top: 4px;
    }
    .gas-pedal-grooves span {
      display: inline-block;
      width: 14px;
      height: 3px;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 2px;
    }
    .btn-gas-square:active, .btn-gas-square.pressed {
      background: #00E676;
      color: #000;
    }
    .btn-gas-square:active .gas-pedal-grooves span,
    .btn-gas-square.pressed .gas-pedal-grooves span {
      background: rgba(0, 0, 0, 0.7);
    }

    /* ── BRUTOPIA MODAL CARDS (Used for Finish Screen) ── */
    .modal-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      touch-action: pan-y !important;
      -webkit-overflow-scrolling: touch;
      overflow-y: auto;
    }

    /* ── 3D SHOWROOM LOBBY HUD (SmashKarts / Deadshot.io style) ── */
    #start-menu-modal {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      pointer-events: none;
      z-index: 45;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px 24px;
      box-sizing: border-box;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    #start-menu-modal.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* ── CUTE YELLOW, BLUE & WHITE LOBBY HUD (SmashKarts Style) ── */
    #start-menu-modal {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      pointer-events: none;
      z-index: 45;
      padding: 16px 24px;
      box-sizing: border-box;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    #start-menu-modal.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* Top Row: Callsign on Left */
    .lobby-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      pointer-events: auto;
      z-index: 50;
    }
    .lobby-callsign-box {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #FFFFFF;
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 16px;
      padding: 6px 16px;
      transition: transform 0.1s, box-shadow 0.1s;
    }
    .lobby-callsign-box:focus-within {
      transform: translate(-1px, -1px);
      box-shadow: 5px 5px 0px #000;
    }
    .callsign-label {
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #1e40af;
    }
    .callsign-input {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      border: none;
      outline: none;
      background: transparent;
      width: 120px;
      color: #000;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* ── CENTER STAGE: AUTHENTIC AIRSKID RACING LOGO ── */
    .lobby-center-branding {
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      pointer-events: none;
      z-index: 48;
      width: 100%;
      max-width: 520px;
    }
    .airskid-brand-svg {
      width: 100%;
      max-width: 460px;
      height: auto;
      filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.65));
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* ── SKY SPEED STREAKS AMBIENT FX ── */
    .sky-speed-streaks {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: hidden;
      z-index: 2;
    }
    .speed-streak {
      position: absolute;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.45), transparent);
      border-radius: 2px;
      animation: streakFly 4s linear infinite;
    }
    .streak-1 { top: 22%; width: 220px; animation-duration: 3.2s; animation-delay: 0s; }
    .streak-2 { top: 38%; width: 300px; animation-duration: 4.5s; animation-delay: 1.5s; }
    .streak-3 { top: 65%; width: 180px; animation-duration: 2.8s; animation-delay: 0.8s; }
    .streak-4 { top: 78%; width: 260px; animation-duration: 3.8s; animation-delay: 2.2s; }
    @keyframes streakFly {
      0% { transform: translateX(100vw); opacity: 0; }
      20% { opacity: 0.8; }
      80% { opacity: 0.8; }
      100% { transform: translateX(-350px); opacity: 0; }
    }

    /* ── CENTER CAROUSEL RACING ARROWS (Aerodynamic Steering Paddles) ── */
    .garage-arrow-btn {
      position: absolute;
      top: 48%;
      transform: translateY(-50%);
      pointer-events: auto;
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: #090E1A;
      border: 2.5px solid #1E293B;
      box-shadow: 0 6px 18px rgba(0,0,0,0.6), 3.5px 3.5px 0 #000;
      color: #00E5FF;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 48;
      transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s, background 0.12s;
      user-select: none;
      -webkit-user-select: none;
    }
    .garage-arrow-left {
      left: calc(50% - 240px);
      top: 50%;
    }
    .garage-arrow-right {
      right: calc(50% - 240px);
      top: 50%;
    }
    .garage-arrow-btn:hover {
      transform: translateY(-50%) translate(-2px, -2px) scale(1.08);
      border-color: #00E5FF;
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.5), 5px 5px 0 #000;
      background: #0F172A;
    }
    .garage-arrow-btn:active {
      transform: translateY(-50%) translate(2px, 2px) scale(0.96);
      box-shadow: 1px 1px 0px #000;
    }
    .arrow-icon-svg {
      width: 26px;
      height: 26px;
      fill: none;
      stroke: currentColor;
      stroke-width: 3.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ── LEFT FLANK: ARCADE GARAGE SHOP DOCK ── */
    .lobby-left-dock {
      position: absolute;
      left: 28px;
      bottom: 245px;
      width: 275px;
      pointer-events: auto;
      z-index: 48;
      box-sizing: border-box;
      transition: opacity 0.22s ease-out, transform 0.22s ease-out;
    }
    .lobby-shop-banner-btn {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      background: linear-gradient(135deg, #FFFDF0 0%, #FFDE59 100%);
      border: 3px solid #000;
      box-shadow: 5px 5px 0px #000;
      border-radius: 18px;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
      text-align: left;
    }
    .lobby-shop-banner-btn:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 7px 7px 0px #000;
      background: linear-gradient(135deg, #FFFFFF 0%, #FFE566 100%);
    }
    .lobby-shop-banner-btn:active {
      transform: translateY(2px) scale(0.98);
      box-shadow: 2px 2px 0px #000;
    }
    .shop-banner-icon-box {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: #FFFFFF;
      border: 2.5px solid #000;
      box-shadow: 2px 2px 0 #000;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .shop-banner-text-col {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 1px;
    }
    .shop-banner-title-row {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .shop-banner-title {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 0.5px;
      color: #000;
      line-height: 1.1;
    }
    .shop-banner-pill {
      font-family: var(--font-display);
      font-size: 8.5px;
      font-weight: 900;
      letter-spacing: 0.5px;
      padding: 1px 6px;
      background: #00D2FF;
      color: #000;
      border: 1.5px solid #000;
      border-radius: 6px;
      box-shadow: 1px 1px 0 #000;
      text-transform: uppercase;
    }
    .shop-banner-subtitle {
      font-family: var(--font-display);
      font-size: 9.5px;
      font-weight: 900;
      color: #000000;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .shop-banner-arrow-box {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: #FFFFFF;
      border: 1.5px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 1px 1px 0 #000;
    }

    /* ── LEFT FLANK: PIT TELEMETRY COCKPIT CARD (WARM ARCADE CREAM + HIGH CONTRAST) ── */
    .machine-hero-badge {
      position: absolute;
      left: 28px;
      bottom: 84px;
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 7px;
      background: linear-gradient(165deg, #FFFFFF 0%, #FFF7D6 100%);
      border: 3px solid #000;
      box-shadow: 5px 5px 0px #000;
      border-radius: 20px;
      padding: 12px 18px;
      z-index: 48;
      width: 275px;
      box-sizing: border-box;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      color: #000;
    }
    .machine-hero-badge:hover {
      transform: translateY(-2px);
      box-shadow: 7px 7px 0px #000;
    }
    .telemetry-meta-header {
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #000000;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .telemetry-dot-blink {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #00D2FF;
      border: 1px solid #000;
      box-shadow: 0 0 6px #00D2FF;
      animation: pulseRumble 1s infinite alternate;
    }
    .machine-hero-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .machine-color-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 2px solid #000;
      box-shadow: 0 0 8px currentColor;
    }
    .machine-name-text {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #000;
      line-height: 1;
    }
    .machine-class-tag {
      font-family: var(--font-display);
      font-size: 9.5px;
      font-weight: 900;
      padding: 2px 8px;
      border-radius: 6px;
      background: #FFDE59;
      color: #000;
      border: 1.5px solid #000;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 1px 1px 0 #000;
    }
    .machine-stats-compact {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
      margin-top: 2px;
    }
    .stat-metric-col {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 900;
      color: #000000;
      letter-spacing: 0.5px;
      width: 100%;
    }
    .stat-metric-svg {
      width: 14px;
      height: 14px;
      fill: none;
      stroke: #000000;
      stroke-width: 2.5;
      vertical-align: middle;
      flex-shrink: 0;
    }
    .mini-stat-bar {
      width: 110px;
      height: 9.5px;
      background: #FFFFFF;
      border: 1.8px solid #000;
      border-radius: 5px;
      overflow: hidden;
      display: inline-flex;
      vertical-align: middle;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.15);
    }
    .mini-stat-fill {
      display: block !important;
      height: 100% !important;
      border-radius: 2px;
      transition: width 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    #stat-bar-speed {
      background: linear-gradient(90deg, #00D2FF 0%, #0284C7 100%) !important;
    }
    #stat-bar-weight {
      background: linear-gradient(90deg, #FFDE59 0%, #F59E0B 100%) !important;
    }
    #stat-bar-grip {
      background: linear-gradient(90deg, #FF385C 0%, #D97706 100%) !important;
    }
    .kart-dots-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-top: 3px;
    }
    .kart-dot-pip {
      width: 14px;
      height: 8px;
      background: #CBD5E1;
      border: 1.5px solid #000;
      transform: skewX(-20deg);
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .kart-dot-pip.active {
      background: #00E5FF;
      transform: skewX(-20deg) scaleY(1.3);
      box-shadow: 0 0 6px #00E5FF;
      border-color: #000;
    }

    /* ── RIGHT FLANK: GRAND PRIX SEASON 1 EVENT CARD (WARM ARCADE CREAM + HIGH CONTRAST) ── */
    .lobby-event-card {
      position: absolute;
      right: 28px;
      bottom: 84px;
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      background: linear-gradient(165deg, #FFFFFF 0%, #FFF7D6 100%);
      border: 3px solid #000;
      box-shadow: 5px 5px 0px #000;
      border-radius: 20px;
      padding: 12px 18px;
      z-index: 48;
      width: 275px;
      box-sizing: border-box;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      color: #000;
    }
    .lobby-event-card:hover {
      transform: translateY(-2px);
      box-shadow: 7px 7px 0px #000;
    }
    .event-meta-header {
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #000000;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .event-tier-pill {
      font-family: var(--font-display);
      font-size: 9px;
      font-weight: 900;
      background: #FFDE59;
      color: #000;
      padding: 2px 7px;
      border-radius: 6px;
      border: 1.5px solid #000;
      letter-spacing: 0.5px;
      box-shadow: 1px 1px 0 #000;
    }
    .event-bounty-box {
      width: 100%;
      background: #FFFFFF;
      border: 2px solid #000;
      box-shadow: 2.5px 2.5px 0 #000;
      border-radius: 12px;
      padding: 8px 10px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .bounty-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }
    .bounty-title {
      font-family: var(--font-display);
      font-size: 11.5px;
      font-weight: 900;
      color: #000000;
      letter-spacing: 0.5px;
    }
    .bounty-reward-pill {
      font-family: var(--font-display);
      font-size: 10px;
      font-weight: 900;
      color: #000000;
      background: #FFDE59;
      padding: 1px 7px;
      border-radius: 6px;
      border: 1.5px solid #000;
      box-shadow: 1px 1px 0 #000;
    }
    .bounty-bar-track {
      width: 100%;
      height: 8px;
      background: #E2E8F0;
      border-radius: 4px;
      overflow: hidden;
      border: 1.5px solid #000;
    }
    .bounty-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #10B981, #00D2FF);
      border-radius: 3px;
    }
    .bounty-subtext {
      font-family: var(--font-telemetry);
      font-size: 8.5px;
      color: #000000;
      font-weight: 900;
      letter-spacing: 0.8px;
    }
    .lobby-tip-banner {
      display: flex;
      align-items: center;
      gap: 7px;
      background: #E0F7FE;
      border: 2px solid #000;
      box-shadow: 2px 2px 0 #000;
      border-radius: 10px;
      padding: 6px 10px;
      width: 100%;
      box-sizing: border-box;
    }
    .tip-bolt {
      color: #000000;
      font-size: 12px;
      font-weight: 900;
    }
    .tip-text {
      font-family: var(--font-telemetry);
      font-size: 8.5px;
      font-weight: 900;
      color: #000000;
      letter-spacing: 0.5px;
      line-height: 1.25;
    }

    /* ── UNIFIED LOBBY BOTTOM WRAPPER (Prevents any overlap) ── */
    .lobby-bottom-wrapper {
      position: absolute;
      bottom: 26px;
      left: 0;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      pointer-events: auto;
      z-index: 50;
      box-sizing: border-box;
    }
    .lobby-action-hub {
      position: static;
      transform: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 6px;
    }

    /* ── LOBBY HERO ACTIONS (PLAY NOW + QUICK MULTIPLAYER) ── */
    .lobby-hero-play-btn {
      font-family: var(--font-display);
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 10px 28px 10px 18px;
      background: linear-gradient(135deg, #FFE600 0%, #FF9500 100%);
      color: #000;
      border: 3.5px solid #000;
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.6), 5px 6px 0px #000, 0 10px 24px rgba(255, 214, 0, 0.45);
      border-radius: 20px;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .lobby-hero-play-btn:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.7), 6px 8px 0px #000, 0 12px 30px rgba(255, 214, 0, 0.65);
    }
    .lobby-hero-play-btn:active {
      transform: translateY(3px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 1px 2px 0px #000;
    }
    .hero-play-icon-bubble {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: #FFFDF5;
      border: 2.5px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 2px 2px 0 #000;
      flex-shrink: 0;
    }
    .hero-play-text-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      line-height: 1.1;
    }
    .hero-play-title {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #000;
    }
    .hero-play-subtitle {
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #451a03;
    }
    .hero-play-badge {
      font-size: 10.5px;
      font-weight: 900;
      background: #000;
      color: #FFDE59;
      padding: 3px 8px;
      border-radius: 6px;
      letter-spacing: 1px;
      margin-left: 4px;
    }

    /* Quick Multiplayer Shortcut */
    .lobby-quick-mp-btn {
      font-family: var(--font-display);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 11px 20px;
      background: linear-gradient(135deg, #00D2FF 0%, #0284C7 100%);
      color: #000;
      border: 3px solid #000;
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.5), 4px 5px 0px #000;
      border-radius: 18px;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .lobby-quick-mp-btn:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.6), 5px 7px 0px #000;
    }
    .lobby-quick-mp-btn:active {
      transform: translateY(3px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 1px 2px 0px #000;
    }
    .quick-mp-text-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      line-height: 1.1;
    }
    .quick-mp-title {
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
    }
    .quick-mp-subtitle {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #082f49;
    }
    .quick-live-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #10B981;
      border: 1.5px solid #000;
      box-shadow: 0 0 6px #10B981;
      animation: livePulse 1.2s infinite alternate;
    }
    @keyframes livePulse {
      0% { opacity: 0.4; transform: scale(0.85); }
      100% { opacity: 1.0; transform: scale(1.15); }
    }

    /* ── FULLSCREEN ARCADE MODE SELECT OVERLAY (YELLOW + WHITE + SKY BLUE) ── */
    .mode-select-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 50% 35%, rgba(12, 18, 34, 0.38) 0%, rgba(8, 14, 28, 0.65) 65%, rgba(3, 6, 15, 0.84) 100%);
      backdrop-filter: blur(3.5px);
      -webkit-backdrop-filter: blur(3.5px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      box-sizing: border-box;
      animation: modalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mode-select-container {
      max-width: 1260px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .mode-select-header {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }
    .mode-back-btn {
      font-family: var(--font-display);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FFFDF5;
      color: #000;
      border: 3px solid #000;
      box-shadow: 3.5px 3.5px 0px #000;
      border-radius: 14px;
      padding: 8px 18px;
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      transition: transform 0.08s, box-shadow 0.08s;
    }
    .mode-back-btn:hover {
      transform: translate(-1px, -1px);
      box-shadow: 5px 5px 0px #000;
    }
    .mode-back-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000;
    }
    .mode-header-title-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
    }
    .mode-header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #000;
      border: 2px solid #000;
      box-shadow: 2px 2px 0 #000;
      border-radius: 8px;
      padding: 3px 10px;
      font-family: var(--font-telemetry);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #FFDE59;
    }
    .mode-header-title {
      font-family: var(--font-display);
      font-size: 36px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #FFFDF5;
      text-shadow: 3px 3px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 4px 4px 0 #000;
      margin: 0;
      line-height: 1;
    }
    .mode-header-stats {
      display: flex;
      align-items: center;
    }
    .mode-stat-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #FFFDF5;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0px #000;
      border-radius: 12px;
      padding: 6px 14px;
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 900;
      color: #000;
    }

    /* 4 Interactive Mode Cards Grid */
    .mode-cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      width: 100%;
    }
    .mode-card {
      background: #FFFDF5;
      border: 3.5px solid #000;
      box-shadow: 6px 6px 0px #000;
      border-radius: 22px;
      padding: 18px 16px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      overflow: hidden;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .mode-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 8px 12px 0px #000;
    }
    .mode-card-ribbon {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 1px;
      padding: 2px 8px;
      border-radius: 6px;
      border: 1.5px solid #000;
      white-space: nowrap;
    }
    .ribbon-yellow { background: #FFDE59; color: #000; }
    .ribbon-cyan   { background: #00D2FF; color: #000; }
    .ribbon-green  { background: #10B981; color: #FFF; text-shadow: 1px 1px 0 #000; }
    .ribbon-red    { background: #FF385C; color: #FFF; text-shadow: 1px 1px 0 #000; }

    .mode-visual-bubble {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      border: 3px solid #000;
      box-shadow: 3px 3px 0 #000;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 18px;
      margin-bottom: 6px;
      transition: transform 0.12s ease;
    }
    .mode-card:hover .mode-visual-bubble {
      transform: scale(1.1) rotate(-3deg);
    }
    .bubble-yellow { background: #FFF9D2; }
    .bubble-cyan   { background: #E0F7FA; }
    .bubble-green  { background: #ECFDF5; }
    .bubble-red    { background: #FFE4E6; }

    .mode-card-title {
      font-family: var(--font-display);
      font-size: 21px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #000;
      margin: 2px 0;
      line-height: 1.1;
    }
    .mode-card-tag {
      font-family: var(--font-display);
      font-size: 9.5px;
      font-weight: 900;
      padding: 2px 8px;
      border-radius: 6px;
      border: 1.5px solid #000;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }
    .tag-yellow { background: #FFDE59; color: #000; }
    .tag-cyan   { background: #00D2FF; color: #000; }
    .tag-green  { background: #10B981; color: #FFF; }
    .tag-red    { background: #FF385C; color: #FFF; }

    .mode-card-desc {
      font-size: 11.5px;
      line-height: 1.35;
      font-weight: 700;
      color: #475569;
      margin: 0 0 10px 0;
      min-height: 38px;
    }
    .mode-features-list {
      list-style: none;
      padding: 0;
      margin: 0 0 14px 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 100%;
      text-align: left;
    }
    .mode-features-list li {
      font-size: 11px;
      font-weight: 800;
      color: #1E293B;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .feat-check {
      color: #10B981;
      font-weight: 900;
      font-size: 13px;
    }
    .mode-action-btn {
      font-family: var(--font-display);
      width: 100%;
      padding: 10px;
      border: 3px solid #000;
      box-shadow: 4px 4px 0 #000;
      border-radius: 14px;
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.08s, box-shadow 0.08s;
      margin-top: auto;
    }
    .mode-action-btn:hover {
      transform: translateY(-2px);
      box-shadow: 5px 6px 0 #000;
    }
    .mode-action-btn:active {
      transform: translateY(2px);
      box-shadow: 1px 1px 0 #000;
    }
    .btn-action-yellow { background: linear-gradient(135deg, #FFDE59 0%, #F59E0B 100%); color: #000; }
    .btn-action-cyan   { background: linear-gradient(135deg, #00D2FF 0%, #0284C7 100%); color: #000; }
    .btn-action-green  { background: linear-gradient(135deg, #34D399 0%, #059669 100%); color: #FFF; text-shadow: 1px 1px 0 #000; }
    .btn-action-red    { background: linear-gradient(135deg, #FF385C 0%, #DC2626 100%); color: #FFF; text-shadow: 1px 1px 0 #000; }

    /* Responsive scaling for mode grid */
    @media (max-width: 1050px) {
      .mode-cards-grid { grid-template-columns: repeat(2, 1fr); max-width: 680px; }
      .mode-header-title { font-size: 28px; }
    }
    @media (max-width: 600px) {
      .mode-cards-grid { grid-template-columns: 1fr; max-width: 340px; }
      .mode-header-title { font-size: 22px; }
      .mode-card-desc { min-height: auto; }
      .lobby-hero-play-btn { padding: 8px 20px 8px 14px; }
      .hero-play-title { font-size: 18px; }
      .lobby-quick-mp-btn { padding: 8px 14px; }
      .quick-mp-title { font-size: 14px; }
    }

    /* ── RUMBLE ARENA SCOREBOARD (NEO-BRUTALIST ARCADE THEME) ── */
    .rumble-hud-bar {
      position: absolute;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 25;
      pointer-events: none;
    }
    .rumble-team-box {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 14px;
      padding: 6px 16px;
      font-family: var(--font-display);
    }
    .rumble-team-box.cyan-box {
      border-color: #000;
      background: linear-gradient(135deg, #e0f9ff 0%, #ffffff 100%);
    }
    .rumble-team-box.crimson-box {
      border-color: #000;
      background: linear-gradient(135deg, #ffe5eb 0%, #ffffff 100%);
    }
    .rumble-team-name {
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 1px;
    }
    .cyan-box .rumble-team-name { color: #0088cc; }
    .crimson-box .rumble-team-name { color: #cc0033; }
    .rumble-team-score {
      font-family: var(--font-digital);
      font-size: 32px;
      font-weight: 900;
      line-height: 1;
      padding: 0 4px;
    }
    .cyan-box .rumble-team-score { color: #0099dd; }
    .crimson-box .rumble-team-score { color: #dd1133; }

    .rumble-center-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: var(--brut-yellow);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 14px;
      padding: 4px 14px;
      text-align: center;
    }
    .rumble-match-title {
      font-family: var(--font-display);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #000;
      text-transform: uppercase;
    }
    .rumble-timer-display {
      font-family: var(--font-telemetry);
      font-size: 16px;
      font-weight: 900;
      color: #000;
      letter-spacing: 1px;
    }

    /* ── KILLFEED NOTIFICATIONS ── */
    .killfeed-container {
      position: absolute;
      top: 76px;
      left: 20px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      align-items: flex-start;
      z-index: 45;
      pointer-events: none;
      max-width: 420px;
    }
    .killfeed-entry {
      background: rgba(13, 18, 28, 0.94);
      color: #fff;
      border: 2.5px solid #000;
      border-radius: 10px;
      padding: 6px 12px;
      font-family: var(--font-telemetry);
      font-size: 13.5px;
      font-weight: 800;
      letter-spacing: 0.5px;
      box-shadow: 3px 3px 0px #000;
      animation: killfeedSlide 0.22s ease-out;
      white-space: nowrap;
      text-transform: uppercase;
    }
    @keyframes killfeedSlide {
      from { transform: translateX(-24px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    .killfeed-entry .team-cyan { color: #00f0ff; font-weight: 900; text-shadow: 0 0 6px rgba(0, 240, 255, 0.6); }
    .killfeed-entry .team-crimson { color: #ff3366; font-weight: 900; text-shadow: 0 0 6px rgba(255, 51, 102, 0.6); }

    /* Rumble Setup Modal Buttons */
    .rumble-format-btn, .rumble-side-btn, .rumble-rule-btn {
      background: #fff;
      color: #000;
      border: 2px solid #000;
      box-shadow: 2.5px 2.5px 0 #000;
      border-radius: 10px;
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 800;
      transition: all 0.08s ease;
    }
    .rumble-format-btn:hover, .rumble-side-btn:hover, .rumble-rule-btn:hover {
      transform: translate(-1px, -1px);
      box-shadow: 3.5px 3.5px 0 #000;
    }
    .rumble-format-btn.active, .rumble-rule-btn.active {
      background: var(--brut-yellow) !important;
      color: #000 !important;
      border-color: #000 !important;
      box-shadow: 2px 2px 0 #000 !important;
      transform: translate(1px, 1px);
    }
    .rumble-side-btn.active[data-side="cyan"] {
      background: #00d2ff !important;
      color: #000 !important;
      border-color: #000 !important;
      box-shadow: 2px 2px 0 #000 !important;
      transform: translate(1px, 1px);
    }
    .rumble-side-btn.active[data-side="crimson"] {
      background: #ff3366 !important;
      color: #fff !important;
      border-color: #000 !important;
      box-shadow: 2px 2px 0 #000 !important;
      transform: translate(1px, 1px);
    }
    .btn-rumble-cta {
      background: var(--brut-red) !important;
      color: #fff !important;
      border: 3px solid #000 !important;
      border-radius: 14px !important;
      box-shadow: 4px 4px 0 #000 !important;
      font-family: var(--font-display) !important;
      font-weight: 900 !important;
      letter-spacing: 2px !important;
      cursor: pointer;
      transition: all 0.08s ease;
    }
    .btn-rumble-cta:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 #000 !important;
    }
    .btn-rumble-cta:active {
      transform: translate(2px, 2px);
      box-shadow: 0px 0px 0 #000 !important;
    }

    /* Modal Racer Name Box */
    .mp-name-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #FFFFFF;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 12px;
      padding: 6px 14px;
      gap: 8px;
    }
    .mp-name-label {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      color: #1e40af;
      white-space: nowrap;
    }
    .mp-name-field {
      font-size: 13px !important;
      padding: 4px 8px !important;
      font-weight: 900 !important;
      letter-spacing: 1px !important;
      text-transform: uppercase !important;
    }

    /* ── CENTERED MULTIPLAYER POPUP MODAL ── */
    /* ── FULLSCREEN MULTIPLAYER HUB OVERLAY & DEDICATED SUITE ── */
    #mp-modal.mp-hub-overlay {
      display: none;
      overflow-y: auto;
    }
    #mp-modal.mp-hub-overlay.open {
      display: flex;
    }
    .mp-hub-container {
      max-width: 1220px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      animation: popIn 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.2);
    }
    .mp-hub-header {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }
    .mp-badge-live {
      background: #000;
      color: #00D2FF;
      border: 2px solid #000;
      box-shadow: 2px 2px 0 #000;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .mp-live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 8px #10B981;
      display: inline-block;
      animation: pulseAnim 1.4s infinite;
    }
    .mp-pilot-box {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FFFDF5;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 14px;
      padding: 6px 14px;
    }
    .mp-pilot-icon {
      font-size: 14px;
    }
    .mp-pilot-label {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      color: #1e40af;
      letter-spacing: 0.5px;
    }
    .mp-pilot-input {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
      border: 2px solid #000;
      border-radius: 8px;
      padding: 4px 8px;
      width: 120px;
      background: #FFF9D2;
      color: #000;
      outline: none;
    }
    .mp-pilot-input:focus {
      background: #FFF;
      border-color: #00D2FF;
      box-shadow: 0 0 0 2px rgba(0, 210, 255, 0.4);
    }

    /* Main Deck Grid: Left Host (7fr) & Right Join (5fr) */
    .mp-hub-main-deck {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 20px;
      width: 100%;
    }

    .mp-host-column, .mp-join-column {
      background: #FFFDF5;
      border: 3.5px solid #000;
      box-shadow: 6px 6px 0 #000;
      border-radius: 24px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-sizing: border-box;
    }

    .mp-column-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 2.5px solid #000;
      border-radius: 16px;
      padding: 10px 14px;
      box-shadow: 3px 3px 0 #000;
    }
    .banner-yellow { background: #FFF9D2; }
    .banner-cyan   { background: #E0F7FA; }

    .mp-banner-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .mp-banner-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #000;
      color: #FFF;
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mp-banner-title {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 0.5px;
      color: #000;
      margin: 0;
      line-height: 1.2;
    }
    .mp-banner-subtitle {
      font-size: 11px;
      color: #475569;
      font-weight: 700;
      margin: 2px 0 0 0;
    }
    .mp-banner-pill {
      font-family: var(--font-telemetry);
      font-size: 9.5px;
      font-weight: 900;
      background: #000;
      color: #FFF;
      padding: 3px 8px;
      border-radius: 6px;
      letter-spacing: 1px;
      white-space: nowrap;
    }

    /* 3 Mode Choice Cards inside Host Section */
    .mp-mode-choices-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      width: 100%;
    }
    .mp-mode-card {
      background: #FFFFFF;
      border: 3px solid #000;
      box-shadow: 4px 4px 0 #000;
      border-radius: 18px;
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: all 0.1s ease;
      user-select: none;
    }
    .mp-mode-card:hover {
      transform: translateY(-4px);
      box-shadow: 6px 8px 0 #000;
    }
    .mp-mode-card.active {
      background: #FFFEEA;
      border-color: #000;
      box-shadow: 5px 5px 0 #000;
      outline: 3px solid #00D2FF;
      transform: translateY(-2px);
    }
    .mp-card-badge {
      font-family: var(--font-telemetry);
      font-size: 8.5px;
      font-weight: 900;
      padding: 2px 6px;
      border-radius: 5px;
      border: 1.5px solid #000;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }
    .badge-yellow { background: #FFDE59; color: #000; }
    .badge-cyan   { background: #00D2FF; color: #000; }
    .badge-red    { background: #FF385C; color: #FFF; }

    .mp-mode-icon-circle {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      border: 2.5px solid #000;
      box-shadow: 2px 2px 0 #000;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 6px;
      transition: transform 0.1s;
    }
    .mp-mode-card:hover .mp-mode-icon-circle {
      transform: scale(1.08) rotate(-3deg);
    }
    .bg-yellow { background: #FFF9D2; }
    .bg-cyan   { background: #E0F7FA; }
    .bg-red    { background: #FFE4E6; }

    .mp-card-name {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 900;
      color: #000;
      margin: 2px 0;
      line-height: 1.1;
    }
    .mp-card-meta {
      font-family: var(--font-display);
      font-size: 9px;
      font-weight: 800;
      color: #0284C7;
      margin-bottom: 4px;
      letter-spacing: 0.5px;
    }
    .mp-card-blurb {
      font-size: 10px;
      line-height: 1.3;
      color: #475569;
      font-weight: 700;
      margin: 0 0 8px 0;
      min-height: 38px;
    }
    .mp-card-active-check {
      font-family: var(--font-display);
      font-size: 9.5px;
      font-weight: 900;
      background: #10B981;
      color: #FFF;
      border: 1.5px solid #000;
      border-radius: 6px;
      padding: 2px 8px;
      display: none;
      letter-spacing: 0.5px;
    }
    .mp-mode-card.active .mp-card-active-check {
      display: inline-block;
    }

    /* Sub-Settings Deck (Laps vs Rumble Rules) */
    .mp-settings-deck {
      background: #F8FAFC;
      border: 2.5px solid #000;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .mp-setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .mp-setting-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-align: left;
    }
    .mp-setting-title {
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 900;
      color: #0f172a;
      letter-spacing: 0.5px;
    }
    .mp-setting-hint {
      font-size: 9.5px;
      color: #64748b;
      font-weight: 700;
    }

    .mp-rumble-subcontrols {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
    }
    .mp-rumble-control-block {
      display: flex;
      flex-direction: column;
      gap: 6px;
      text-align: left;
    }
    .mp-pill-selector {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .mp-pill-opt {
      font-family: var(--font-display);
      font-size: 10.5px;
      font-weight: 900;
      background: #FFF;
      border: 2px solid #000;
      box-shadow: 2px 2px 0 #000;
      border-radius: 8px;
      padding: 6px 10px;
      cursor: pointer;
      color: #000;
      transition: all 0.08s;
    }
    .mp-pill-opt:hover {
      background: #FFF9D2;
      transform: translate(-1px, -1px);
    }
    .mp-pill-opt.active {
      background: #00D2FF;
      color: #000;
      box-shadow: 1px 1px 0 #000;
      transform: translate(1px, 1px);
    }

    /* Hero Host Button */
    .mp-hero-create-btn {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
      background: #FFDE59;
      color: #000;
      border: 3.5px solid #000;
      box-shadow: 5px 5px 0 #000;
      border-radius: 16px;
      padding: 12px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      transition: all 0.1s ease;
    }
    .mp-hero-create-btn:hover {
      background: #FFE600;
      transform: translateY(-2px);
      box-shadow: 7px 7px 0 #000;
    }
    .mp-hero-create-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 #000;
    }

    /* Right Column: Join Card */
    .mp-join-body-card {
      background: #FFFFFF;
      border: 3px solid #000;
      box-shadow: 4px 4px 0 #000;
      border-radius: 18px;
      padding: 24px 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
      height: 100%;
      box-sizing: border-box;
      justify-content: center;
    }
    .mp-join-icon-bubble {
      width: 64px;
      height: 64px;
      border-radius: 20px;
      background: #E0F7FA;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mp-join-heading {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #000;
      margin: 0;
    }
    .mp-join-prompt {
      font-size: 11.5px;
      color: #475569;
      font-weight: 700;
      line-height: 1.4;
      margin: 0;
      max-width: 300px;
    }
    .mp-input-wrap {
      width: 100%;
      max-width: 280px;
    }
    .mp-code-input {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 900;
      letter-spacing: 2px;
      text-align: center;
      text-transform: uppercase;
      width: 100%;
      padding: 10px 14px;
      border: 3px solid #000;
      border-radius: 12px;
      box-shadow: 3px 3px 0 #000;
      background: #FFFDF5;
      color: #000;
      box-sizing: border-box;
      outline: none;
    }
    .mp-code-input:focus {
      background: #FFF;
      border-color: #00D2FF;
      box-shadow: 0 0 0 3px rgba(0, 210, 255, 0.4);
    }
    .mp-hero-join-btn {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
      background: #00D2FF;
      color: #000;
      border: 3px solid #000;
      box-shadow: 4px 4px 0 #000;
      border-radius: 14px;
      padding: 12px 24px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      max-width: 280px;
      transition: all 0.1s ease;
    }
    .mp-hero-join-btn:hover {
      background: #38BDF8;
      transform: translateY(-2px);
      box-shadow: 6px 6px 0 #000;
    }
    .mp-hero-join-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 #000;
    }
    .mp-join-footer-tip {
      font-size: 10px;
      color: #64748b;
      font-weight: 700;
      line-height: 1.35;
      display: flex;
      align-items: flex-start;
      gap: 5px;
      text-align: left;
      background: #F8FAFC;
      border: 1.5px solid #CBD5E1;
      border-radius: 8px;
      padding: 8px 10px;
      max-width: 320px;
    }
    .tip-star {
      color: #F59E0B;
      font-weight: 900;
    }

    /* ── ACTIVE WAITING ROOM DECK ── */
    .mp-waiting-room-deck {
      background: #FFFDF5;
      border: 4px solid #000;
      box-shadow: 8px 8px 0 #000;
      border-radius: 24px;
      padding: 24px 28px;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 18px;
      box-sizing: border-box;
      animation: popIn 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.2);
    }
    .mp-room-info-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      background: #FFF9D2;
      border: 3px solid #000;
      box-shadow: 3.5px 3.5px 0 #000;
      border-radius: 16px;
      padding: 12px 18px;
    }
    .mp-room-tags-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .mp-tag-unit {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .mp-tag-label {
      font-family: var(--font-telemetry);
      font-size: 10px;
      font-weight: 900;
      color: #64748b;
      letter-spacing: 1px;
    }
    .mp-tag-value {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      padding: 3px 10px;
      border-radius: 8px;
      border: 2px solid #000;
      box-shadow: 1.5px 1.5px 0 #000;
      letter-spacing: 0.5px;
    }
    .val-yellow { background: #FFDE59; color: #000; font-size: 18px; letter-spacing: 1.5px; }
    .val-cyan   { background: #00D2FF; color: #000; }
    .val-white  { background: #FFF; color: #000; }

    .mp-copy-link-btn {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      background: #FFF;
      color: #000;
      border: 2.5px solid #000;
      box-shadow: 2.5px 2.5px 0 #000;
      border-radius: 10px;
      padding: 6px 14px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.08s;
    }
    .mp-copy-link-btn:hover {
      background: #FFDE59;
      transform: translate(-1px, -1px);
      box-shadow: 3.5px 3.5px 0 #000;
    }
    .mp-copy-link-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 0 0 0 #000;
    }

    .mp-roster-section {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
    }
    .mp-roster-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #000;
      padding-bottom: 6px;
    }
    .mp-roster-title {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 900;
      color: #1e40af;
      display: flex;
      align-items: center;
      gap: 6px;
      letter-spacing: 0.5px;
    }
    .mp-roster-counter {
      font-family: var(--font-telemetry);
      font-size: 11px;
      font-weight: 900;
      color: #475569;
      letter-spacing: 1px;
    }
    .mp-roster-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      width: 100%;
      box-sizing: border-box;
      padding: 4px 2px;
    }
    @media (max-width: 900px) {
      .mp-roster-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 580px) {
      .mp-roster-grid {
        grid-template-columns: 1fr;
      }
    }
    .mp-podium-card {
      background: #FFFFFF;
      border: 3.5px solid #000;
      box-shadow: 5px 5px 0 #000;
      border-radius: 20px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      text-align: center;
      gap: 6px;
      position: relative;
      min-height: 168px;
      box-sizing: border-box;
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .mp-podium-card:hover {
      transform: translateY(-3px);
      box-shadow: 7px 7px 0 #000;
    }
    .mp-podium-card.is-self {
      background: #FFFFF2;
      border-color: #000;
      outline: 3px solid #00D2FF;
      box-shadow: 6px 6px 0 #000;
    }
    .mp-podium-top {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mp-podium-role {
      font-family: var(--font-telemetry);
      font-size: 9.5px;
      font-weight: 900;
      padding: 2px 7px;
      border-radius: 6px;
      border: 1.5px solid #000;
      letter-spacing: 0.5px;
    }
    .role-host { background: #FFDE59; color: #000; }
    .role-guest { background: #E2E8F0; color: #1E293B; }
    .mp-podium-you-tag {
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 900;
      background: #00D2FF;
      color: #000;
      border: 1.5px solid #000;
      border-radius: 5px;
      padding: 2px 6px;
      letter-spacing: 1px;
    }
    .mp-podium-ping {
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 800;
      color: #10B981;
    }
    .mp-podium-avatar-wrap {
      width: 100%;
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle, #F8FAFC 25%, #E2E8F0 100%);
      border: 2px solid #000;
      border-radius: 14px;
      padding: 2px;
      box-sizing: border-box;
      overflow: visible;
      transition: transform 0.12s ease;
    }
    .mp-podium-card:hover .mp-podium-avatar-wrap {
      transform: scale(1.04);
    }
    .mp-podium-name {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #000;
      margin: 0;
      line-height: 1.1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
    .mp-podium-kart-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #F1F5F9;
      border: 1.5px solid #000;
      border-radius: 8px;
      padding: 3px 8px;
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 0.5px;
    }
    .mp-podium-kart-badge .kart-label {
      color: #0284C7;
      border-right: 1.5px solid #CBD5E1;
      padding-right: 5px;
    }
    .mp-podium-kart-badge .skin-label {
      color: #D97706;
    }

    /* Empty waiting podium slot */
    .mp-podium-empty {
      background: rgba(255, 255, 255, 0.45);
      border: 3px dashed #94A3B8;
      box-shadow: none;
      opacity: 0.8;
    }
    .mp-podium-empty:hover {
      transform: none;
      box-shadow: none;
      border-color: #64748B;
    }
    .mp-empty-slot-tag {
      font-family: var(--font-telemetry);
      font-size: 9px;
      font-weight: 900;
      color: #94A3B8;
      letter-spacing: 1px;
    }
    .mp-empty-avatar-wrap {
      width: 100%;
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px dashed #CBD5E1;
      border-radius: 14px;
      background: rgba(241, 245, 249, 0.4);
    }
    .mp-empty-plus {
      font-size: 24px;
      font-weight: 900;
      color: #94A3B8;
      animation: pulseAnim 2s infinite ease-in-out;
    }
    .mp-empty-title {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 900;
      color: #64748B;
      letter-spacing: 0.5px;
    }
    .mp-empty-desc {
      font-family: var(--font-telemetry);
      font-size: 8.5px;
      font-weight: 800;
      color: #94A3B8;
      letter-spacing: 0.5px;
    }
    .pill-host { background: #FFDE59; color: #000; }
    .pill-guest { background: #E2E8F0; color: #334155; }

    .mp-waiting-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      border-top: 2px solid #000;
      padding-top: 14px;
    }
    .mp-btn-leave {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 900;
      background: #FFF;
      color: #FF385C;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 12px;
      padding: 10px 18px;
      cursor: pointer;
      transition: all 0.08s;
    }
    .mp-btn-leave:hover {
      background: #FFE4E6;
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0 #000;
    }
    .mp-btn-leave:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 #000;
    }
    .mp-btn-launch {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 900;
      letter-spacing: 1px;
      background: #FFDE59;
      color: #000;
      border: 3.5px solid #000;
      box-shadow: 6px 6px 0 #000;
      border-radius: 16px;
      padding: 12px 28px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      transition: all 0.1s ease;
      flex: 1;
      justify-content: center;
    }
    .mp-btn-launch:hover:not(:disabled) {
      background: #FFE600;
      transform: translateY(-2px);
      box-shadow: 8px 8px 0 #000;
    }
    .mp-btn-launch:active:not(:disabled) {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 #000;
    }
    .mp-btn-launch:disabled {
      background: #E2E8F0;
      color: #64748b;
      cursor: not-allowed;
      border-color: #94A3B8;
      box-shadow: 3px 3px 0 #94A3B8;
    }

    /* Responsive styling for Mobile & Small Windows */
    @media (max-width: 900px) {
      .mp-hub-main-deck {
        grid-template-columns: 1fr;
      }
      .mp-mode-choices-grid {
        grid-template-columns: 1fr;
      }
      .mp-hub-container {
        max-width: 100%;
      }
      .mp-waiting-footer {
        flex-direction: column-reverse;
      }
      .mp-btn-launch, .mp-btn-leave {
        width: 100%;
      }
    }

    /* ── MOBILE RESPONSIVE SHOWROOM LOBBY (Compact & Cute for Phones & Landscape) ── */
    @media (max-width: 950px), (max-height: 520px), (hover: none) and (pointer: coarse) {
      #start-menu-modal {
        padding: 8px 12px;
      }
      #top-bar {
        top: 8px;
        right: 12px;
        gap: 6px;
      }
      #sound-toggle, #fullscreen-btn {
        font-size: 10px;
        padding: 4px 8px;
        border-radius: 8px;
        border: 2px solid #000;
        box-shadow: 2px 2px 0 #000;
      }
      .lobby-callsign-box {
        padding: 3px 10px;
        border-radius: 10px;
        border: 2px solid #000;
        box-shadow: 2px 2px 0 #000;
        gap: 4px;
      }
      .callsign-label {
        font-size: 9px;
      }
      .callsign-input {
        font-size: 11px;
        width: 70px;
      }
      .lobby-center-branding {
        top: 6px;
        max-width: 320px;
      }
      .airskid-brand-svg {
        max-width: 290px;
      }
      .garage-arrow-btn {
        width: 38px;
        height: 38px;
        font-size: 16px;
        border: 2.5px solid #000;
        box-shadow: 2.5px 2.5px 0 #000;
        top: 42%;
      }
      .garage-arrow-left {
        left: max(14px, calc(50% - 210px));
      }
      .garage-arrow-right {
        right: max(14px, calc(50% - 210px));
      }
      .machine-hero-badge {
        top: auto;
        bottom: 50px;
        left: 50%;
        transform: translateX(-50%);
        padding: 3px 12px;
        gap: 2px;
        border: 2px solid #000;
        box-shadow: 2.5px 2.5px 0 #000;
        border-radius: 12px;
        background: #FFFFFF;
      }
      .machine-hero-title-row {
        gap: 6px;
      }
      .machine-name-text {
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.5px;
      }
      .machine-class-tag {
        font-size: 8px;
        padding: 1px 4px;
        border-radius: 4px;
      }
      .machine-color-dot {
        width: 8px;
        height: 8px;
      }
      .machine-stats-compact {
        font-size: 8.5px;
        font-weight: 900;
        gap: 8px;
      }
      .mini-stat-bar {
        width: 32px;
        height: 7px;
        border: 1px solid #000;
        border-radius: 4px;
        margin-left: 3px;
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.5);
      }
      .kart-dots-row {
        display: none;
      }
      .lobby-action-hub {
        bottom: 10px;
        gap: 8px;
      }
      .lobby-play-btn {
        font-size: 12px;
        padding: 5px 14px;
        border: 2.5px solid #000;
        box-shadow: 2.5px 2.5px 0 #000;
        border-radius: 12px;
        gap: 5px;
      }
      .btn-play-icon {
        font-size: 14px;
      }
      .mp-live-pill {
        font-size: 7.5px;
        padding: 1px 4px;
      }

      /* Responsive Multiplayer Modal for Mobile & Landscape */
      #mp-modal {
        padding: 8px;
      }
      .mp-popup-card {
        padding: 12px 16px;
        gap: 8px;
        max-width: 500px;
        border-radius: 16px;
        border-width: 3px;
        box-shadow: 5px 5px 0 #000;
        max-height: 94vh;
      }
      .mp-modal-top {
        padding-bottom: 6px;
        border-bottom-width: 2px;
      }
      .mp-modal-badge {
        font-size: 13px;
        padding: 3px 10px;
      }
      .mp-close-btn {
        width: 30px;
        height: 30px;
        font-size: 13px;
      }
      .mp-name-bar {
        padding: 4px 10px;
        border-radius: 10px;
      }
      .mp-name-label {
        font-size: 10.5px;
      }
      .mp-name-field {
        font-size: 11px !important;
        padding: 3px 6px !important;
      }
      .mp-cards-grid {
        gap: 8px;
      }
      .mp-action-box {
        padding: 8px 10px;
        border-radius: 12px;
        border-width: 2.5px;
        box-shadow: 2.5px 2.5px 0 #000;
        gap: 4px;
      }
      .mp-action-title {
        font-size: 11px;
      }
      .mp-action-desc {
        font-size: 9px;
        line-height: 1.2;
      }
      .lap-choice-btn {
        padding: 2px 7px;
        font-size: 11px;
      }
    }

    @media (max-height: 420px) {
      .lobby-center-branding {
        top: 4px;
        max-width: 250px;
      }
      .airskid-brand-svg {
        max-width: 230px;
      }
      .machine-hero-badge {
        top: auto;
        bottom: 48px;
        padding: 2px 10px;
        transform: translateX(-50%);
      }
      .machine-stats-compact {
        font-size: 8px;
        gap: 6px;
      }
      .mini-stat-bar {
        width: 28px;
        height: 6.5px;
      }
      .lobby-action-hub {
        bottom: 8px;
        gap: 6px;
      }
      .lobby-play-btn {
        font-size: 11.5px;
        padding: 4px 12px;
        border-radius: 10px;
      }
    }

    .menu-card {
      background: var(--brut-cream);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-lg);
      border-radius: 24px;
      padding: 24px 28px;
      max-width: 620px;
      width: 100%;
      color: var(--brut-black);
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 14px;
      max-height: 94vh;
      overflow-y: auto;
      touch-action: pan-y !important;
      -webkit-overflow-scrolling: touch;
    }

    .game-logo-badge {
      display: inline-block;
      background: var(--brut-yellow);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 16px;
      padding: 6px 24px;
      transform: rotate(-1.5deg);
      margin-bottom: 4px;
    }
    .game-logo {
      font-family: var(--font-display);
      font-size: 46px;
      font-weight: 900;
      letter-spacing: 2px;
      color: var(--brut-black);
      line-height: 1.1;
    }
    .game-tagline {
      font-family: var(--font-telemetry);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: #555;
      text-transform: uppercase;
    }

    /* Prominent Game Mode Selection Cards */
    .mode-select-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 6px 0;
    }
    .mode-card {
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 16px;
      padding: 10px 12px;
      cursor: pointer;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 4px;
      transition: all 0.12s ease;
      position: relative;
    }
    .mode-card:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--brut-shadow);
    }
    .mode-card.active {
      background: #FFF9D2;
      border-color: #000;
      box-shadow: var(--brut-shadow);
      outline: 3.5px solid var(--brut-yellow);
      outline-offset: -3.5px;
    }
    .mode-card#tab-multiplayer.active {
      background: #E0F7FA;
      outline-color: #00D2FF;
    }
    .mode-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .mode-badge {
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 6px;
      background: #e2e8f0;
      color: #333;
      border: 1.5px solid #000;
      text-transform: uppercase;
    }
    .mode-badge.mp-badge {
      background: #00D2FF;
      color: #000;
      animation: pulseOnline 1.5s infinite alternate;
    }
    @keyframes pulseOnline {
      0% { opacity: 0.85; transform: scale(0.97); }
      100% { opacity: 1; transform: scale(1.03); }
    }
    .mode-icon {
      font-size: 20px;
    }
    .mode-name {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 900;
      color: #000;
      line-height: 1.1;
    }
    .mode-desc {
      font-size: 10.5px;
      font-weight: 700;
      color: #666;
    }

    /* Quick Mode Switcher Banner Button */
    .quick-switch-btn {
      background: #00D2FF;
      color: #000;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.5px;
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 12px;
      padding: 10px 14px;
      cursor: pointer;
      transition: all 0.12s ease;
      display: block;
      width: 100%;
      text-align: center;
      margin-top: 4px;
    }
    .quick-switch-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--brut-shadow);
      background: #33E1FF;
    }
    .quick-switch-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px #000;
    }
    .quick-switch-btn.solo-mode {
      background: #FFDE59;
    }

    /* Kart Selection Grid */
    .kart-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin: 4px 0;
    }
    .kart-card {
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 14px;
      padding: 12px;
      cursor: pointer;
      transition: all 0.12s;
      text-align: left;
    }
    .kart-card:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--brut-shadow);
    }
    .kart-card.selected {
      border-color: #000;
      background: #FFF9D2;
      box-shadow: var(--brut-shadow);
      transform: translate(-2px, -2px);
      outline: 3px dashed var(--brut-red);
      outline-offset: -5px;
    }
    .kart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .kart-name {
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }
    .kart-badge {
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 6px;
      font-weight: 800;
      border: 1.5px solid #000;
      text-transform: uppercase;
      color: #fff;
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 700;
      color: #555;
      margin-top: 3px;
    }
    .stat-bar {
      width: 70px;
      height: 7px;
      background: #eee;
      border: 1.5px solid #000;
      border-radius: 4px;
      overflow: hidden;
    }
    .stat-fill {
      height: 100%;
      background: var(--brut-yellow-dark);
    }

    /* Multiplayer Sub-Panels */
    #multiplayer-panel {
      display: none;
      flex-direction: column;
      gap: 12px;
      text-align: left;
    }
    .mp-row {
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .brut-input {
      width: 100%;
      padding: 10px 14px;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 700;
      border: var(--brut-border);
      border-radius: 12px;
      box-shadow: var(--brut-shadow-sm);
      background: #fff;
    }
    .mp-cards-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .mp-box {
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .mp-box-title {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 800;
    }

    .lap-select-group {
      display: inline-flex;
      background: #E5E7EB;
      border: 2px solid #000;
      border-radius: 8px;
      overflow: hidden;
    }
    .lap-choice-btn {
      padding: 3px 8px;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 800;
      border: none;
      background: #E5E7EB;
      color: #555;
      cursor: pointer;
      transition: all 0.1s;
    }
    .lap-choice-btn:hover {
      background: #D1D5DB;
    }
    .lap-choice-btn.active {
      background: var(--brut-yellow);
      color: #000;
      box-shadow: inset 0 -2px 0 #000;
    }

    /* Lobby List */
    #lobby-view {
      display: none;
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 14px;
      padding: 14px;
      text-align: left;
      flex-direction: column;
      gap: 10px;
    }
    .lobby-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #000;
      padding-bottom: 8px;
    }
    .lobby-code-tag {
      background: var(--brut-yellow);
      border: 2px solid #000;
      padding: 4px 10px;
      border-radius: 8px;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 800;
    }
    .player-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .player-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 10px;
      background: #f9f9f9;
      border: 2px solid #000;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
    }

    .start-btn {
      font-family: var(--font-display);
      font-size: 26px;
      letter-spacing: 2px;
      padding: 14px 28px;
      border-radius: 16px;
      background: var(--brut-yellow);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      cursor: pointer;
      color: #000;
      font-weight: 900;
      transition: all 0.1s;
    }
    .start-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--brut-shadow-lg);
    }
    .start-btn:active {
      transform: translate(3px, 3px);
      box-shadow: 2px 2px 0px #000;
    }

    .controls-hint {
      font-size: 12px;
      font-weight: 700;
      color: #555;
      line-height: 1.5;
      background: var(--brut-white);
      border: 2px solid #000;
      border-radius: 10px;
      padding: 8px 12px;
    }
    .controls-hint kbd {
      background: var(--brut-yellow);
      border: 1.5px solid #000;
      padding: 1px 5px;
      border-radius: 4px;
      color: #000;
      font-weight: 800;
    }

    /* Finish Podium Table */
    .results-table {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0;
      text-align: left;
      border: var(--brut-border);
      border-radius: 12px;
      overflow: hidden;
      background: var(--brut-white);
    }
    .results-table th {
      background: var(--brut-yellow);
      color: #000;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1px;
      padding: 8px 12px;
      border-bottom: 2px solid #000;
    }
    .results-table td {
      padding: 8px 12px;
      border-bottom: 1.5px solid #eee;
      font-size: 15px;
      font-weight: 800;
      color: #000;
    }
    .results-table tr.highlight {
      background: #FFF9D2;
      border-left: 4px solid var(--brut-red);
    }

    /* Responsive scaling for phones */
    @media (max-width: 600px) {
      .top-left-hud { top: 10px; left: 10px; gap: 8px; }
      .pos-badge { font-size: 24px; padding: 4px 10px; }
      .lap-box { padding: 4px 8px; }
      .lap-num { font-size: 18px; }
      .top-right-hud { top: 10px; right: 10px; }
      #minimap-canvas { width: 90px; height: 90px; }

      /* Mobile Start Menu Modal */
      .modal-overlay { padding: 8px 6px !important; }
      .menu-card {
        padding: 12px 14px !important;
        gap: 8px !important;
        max-height: 96vh !important;
        border-radius: 18px !important;
      }
      .game-logo-badge {
        padding: 4px 14px !important;
        margin-bottom: 2px !important;
      }
      .game-logo { font-size: 26px !important; }
      .game-tagline { font-size: 10px !important; letter-spacing: 0.8px !important; }
      .brut-input { font-size: 13px !important; padding: 7px 10px !important; border-radius: 10px !important; }

      /* Compact 2x2 Kart Selection on Mobile */
      .kart-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 6px !important;
      }
      .kart-card {
        padding: 6px 8px !important;
        border-radius: 10px !important;
      }
      .kart-header { margin-bottom: 2px !important; }
      .kart-name { font-size: 13px !important; }
      .kart-badge { font-size: 8px !important; padding: 1px 4px !important; }
      .stat-row { font-size: 9px !important; margin-top: 1px !important; }
      .stat-bar { width: 42px !important; height: 5px !important; }

      /* Mobile Multiplayer controls */
      .mp-cards-grid {
        grid-template-columns: 1fr !important;
        gap: 8px !important;
      }
      .mp-box {
        padding: 8px 10px !important;
        gap: 5px !important;
        border-radius: 10px !important;
      }
      .mp-box-title { font-size: 13px !important; }
      #lobby-view { padding: 10px !important; gap: 6px !important; }
      .player-item { padding: 4px 8px !important; font-size: 12px !important; }

      .start-btn {
        font-size: 18px !important;
        padding: 10px 16px !important;
        border-radius: 12px !important;
      }
      .controls-hint {
        font-size: 9.5px !important;
        padding: 5px 8px !important;
        line-height: 1.3 !important;
      }
      #top-bar { right: 110px; top: 10px; }

      /* Sleek compact notifications & overlays on phone screens */
      #alert-banner {
        top: 48px !important;
        font-size: 12px !important;
        padding: 4px 10px !important;
        letter-spacing: 0.5px !important;
        border: 2px solid #000 !important;
        box-shadow: 2px 2px 0px #000 !important;
        border-radius: 8px !important;
        max-width: 85vw !important;
        white-space: nowrap !important;
      }
      #countdown-overlay {
        font-size: 76px !important;
      }
      #wrong-way-banner {
        font-size: 14px !important;
        padding: 6px 14px !important;
        border-width: 2.5px !important;
        border-radius: 12px !important;
      }

      .live-standings-card {
        top: 66px !important;
        left: 14px !important;
        padding: 4px 6px !important;
        min-width: 142px !important;
      }
      .standings-title { font-size: 8.5px !important; }
      .standing-row { font-size: 10px !important; padding: 1px 3px !important; gap: 4px !important; }
      .standing-name-text { max-width: 60px !important; }
      .standing-lap-tag { font-size: 9px !important; padding: 1px 4px !important; }
      #finish-countdown-banner {
        top: 14px !important;
        font-size: 13px !important;
        padding: 4px 12px !important;
      }
      #spectator-overlay {
        bottom: 110px !important;
        padding: 6px 12px !important;
      }
      .spectator-badge { font-size: 12px !important; }
      .spectator-btn { font-size: 10px !important; padding: 3px 8px !important; }

      .killfeed-container {
        top: 56px !important;
        left: 10px !important;
        gap: 4px !important;
        max-width: 80vw !important;
      }
      .killfeed-entry {
        font-size: 10.5px !important;
        padding: 3px 8px !important;
        border-width: 2px !important;
        box-shadow: 2px 2px 0px #000 !important;
      }

      /* Mobile In-Game Controls (NFS / Asphalt Style) */
      .touch-steer-cluster { bottom: 16px; left: 14px; gap: 8px; }
      .btn-steer { width: 66px; height: 66px; border-radius: 14px; }
      .btn-steer .ctrl-icon { font-size: 24px; }
      .btn-steer .ctrl-sub { font-size: 8px; }

      .touch-action-cluster { bottom: 16px; right: 14px; gap: 8px; }
      .touch-pedal-row { gap: 8px; }
      .btn-brake-square { width: 66px; height: 66px; border-radius: 14px; }
      .btn-gas-square { width: 78px; height: 78px; border-radius: 16px; }
      .btn-gas-square .ctrl-icon-gas { font-size: 24px; }
      .btn-gas-square .ctrl-label-gas { font-size: 12px; }
      .btn-drift { width: 72px; height: 42px; font-size: 11px; }
      .btn-respawn { width: 42px; height: 42px; border-radius: 12px; }

      /* Mobile adjustments for cute lobby top-bar & footer */
      .lobby-user-cluster { gap: 6px !important; }
      .lobby-level-box { padding: 3px 8px !important; border-radius: 12px !important; border-width: 2px !important; box-shadow: 2px 2px 0 #000 !important; }
      .lobby-level-pill { font-size: 10px !important; padding: 1px 5px !important; }
      .lobby-xp-track { width: 38px !important; height: 6px !important; }
      .currency-pill { font-size: 11.5px !important; padding: 3px 8px !important; border-radius: 12px !important; border-width: 2px !important; box-shadow: 2px 2px 0 #000 !important; }
      .currency-icon { font-size: 13px !important; }
      .currency-plus { width: 16px !important; height: 16px !important; font-size: 11px !important; }
      .lobby-icon-btn { width: 32px !important; height: 32px !important; font-size: 14px !important; border-radius: 10px !important; border-width: 2px !important; box-shadow: 2px 2px 0 #000 !important; }
      .gift-badge-dot { font-size: 7.5px !important; padding: 1px 3px !important; top: -5px !important; right: -5px !important; }
      .lobby-footer-bar { padding: 2px 4px 0 4px !important; }
      .footer-link-btn { font-size: 9.5px !important; padding: 2px 6px !important; border-radius: 6px !important; }
      .version-tag, .studio-tag { font-size: 8.5px !important; padding: 1px 5px !important; }
      .footer-badge-group { display: none !important; }
      .lobby-event-card { display: none !important; }
      .lobby-left-dock {
        top: 68px !important;
        bottom: auto !important;
        left: 16px !important;
        width: 175px !important;
      }
      .lobby-shop-banner-btn {
        padding: 5px 10px !important;
        border-radius: 12px !important;
        gap: 8px !important;
      }
      .shop-banner-icon-box {
        width: 28px !important;
        height: 28px !important;
        border-radius: 8px !important;
      }
      .shop-banner-title {
        font-size: 12px !important;
      }
      .shop-banner-subtitle {
        display: none !important;
      }
      .shop-banner-arrow-box {
        display: none !important;
      }
      .machine-hero-badge {
        left: 50% !important;
        transform: translateX(-50%) !important;
        bottom: 84px !important;
        width: calc(100% - 32px) !important;
        max-width: 320px !important;
        padding: 8px 14px !important;
      }
      .garage-arrow-left { left: 8px !important; }
      .garage-arrow-right { right: 8px !important; }
    }

    /* ── SMASHKARTS CUTE LOBBY TOP & FOOTER EXTENSIONS ── */
    .lobby-user-cluster {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .lobby-level-box {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #FFFFFF;
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 16px;
      padding: 6px 12px;
    }
    .lobby-level-pill {
      background: var(--brut-yellow);
      border: 2px solid #000;
      border-radius: 8px;
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      padding: 2px 7px;
      letter-spacing: 0.5px;
    }
    .lobby-xp-track {
      width: 60px;
      height: 9px;
      background: #E5E7EB;
      border: 2px solid #000;
      border-radius: 6px;
      overflow: hidden;
    }
    .lobby-xp-fill {
      height: 100%;
      background: linear-gradient(90deg, #10B981, #00D2FF);
      transition: width 0.3s ease;
    }

    .lobby-currencies-cluster {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .currency-pill {
      background: #FFFFFF;
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 16px;
      padding: 5px 12px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      cursor: pointer;
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 800;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }
    .currency-pill:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px #000;
    }
    .currency-pill:active {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0px #000;
    }
    .currency-icon {
      font-size: 16px;
      filter: drop-shadow(1px 1px 0 rgba(0,0,0,0.2));
    }
    .currency-val {
      font-family: var(--font-display);
      letter-spacing: 0.5px;
      color: #000;
    }
    .currency-plus {
      background: var(--brut-yellow);
      border: 2px solid #000;
      border-radius: 6px;
      width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 900;
      line-height: 1;
      margin-left: 2px;
      box-shadow: 1px 1px 0 #000;
    }
    .coin-pill .currency-plus { background: #FFDE59; }
    .gem-pill .currency-plus { background: #00D2FF; }

    .lobby-icon-btn {
      width: 42px;
      height: 42px;
      background: #FFFFFF;
      border: 3px solid #000;
      box-shadow: 4px 4px 0px #000;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      position: relative;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }
    .lobby-icon-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px #000;
    }
    .lobby-icon-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0px #000;
    }
    .lobby-icon-btn.gift-btn {
      background: #FF385C;
      color: #FFF;
    }
    .gift-badge-dot {
      position: absolute;
      top: -7px;
      right: -8px;
      background: #FFDE59;
      color: #000;
      border: 2px solid #000;
      box-shadow: 1px 1px 0 #000;
      border-radius: 6px;
      font-family: var(--font-display);
      font-size: 9px;
      font-weight: 900;
      padding: 1px 5px;
    }
    @keyframes pulseBounce {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.18); }
    }
    .pulse-anim {
      animation: pulseBounce 1.2s infinite ease-in-out;
    }

    /* ── LOBBY FOOTER BAR (SmashKarts Style) ── */
    .lobby-footer-bar {
      width: 100%;
      max-width: 960px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      pointer-events: auto;
      padding: 0 16px;
      box-sizing: border-box;
      margin: 0 auto;
    }

    /* ── VIP BADGE & VIP EFFECTS ── */
    .lobby-vip-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #FFFFFF;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 12px;
      padding: 5px 10px;
      cursor: pointer;
      font-family: var(--font-display);
      font-size: 11.5px;
      font-weight: 900;
      letter-spacing: 0.5px;
      transition: all 0.1s ease;
    }
    .lobby-vip-badge:hover {
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0 #000;
      background: #FFF9D2;
    }
    .lobby-vip-badge.is-vip {
      background: linear-gradient(135deg, #FFD700 0%, #FF9900 100%);
      color: #000;
      border-color: #000;
      animation: pulseVip 1.5s infinite alternate;
    }
    @keyframes pulseVip {
      0% { filter: drop-shadow(0 0 3px rgba(255, 215, 0, 0.6)); }
      100% { filter: drop-shadow(0 0 10px rgba(255, 153, 0, 0.9)); }
    }

    /* ── 3D GARAGE SHOWROOM STORE CSS ── */
    body.showroom-store-open #top-bar,
    body.showroom-store-open #lobby-event-card,
    body.showroom-store-open #machine-hero-badge,
    body.showroom-store-open .lobby-bottom-wrapper,
    body.showroom-store-open .garage-arrow-btn,
    body.showroom-store-open .lobby-center-branding,
    body.showroom-store-open .lobby-left-dock {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translateY(20px) !important;
      transition: opacity 0.22s ease-out, transform 0.22s ease-out !important;
    }

    body.showroom-store-open .lobby-center-branding {
      transform: translateY(-20px) !important;
    }

    .garage-showroom-overlay {
      position: fixed;
      inset: 0;
      z-index: 90;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      animation: fadeInShowroom 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes fadeInShowroom {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* ── TOP SHOWROOM HEADER ── */
    .showroom-top-bar {
      pointer-events: auto;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      z-index: 100;
    }
    .showroom-back-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--brut-white);
      color: #000;
      border: var(--brut-border);
      box-shadow: var(--brut-shadow);
      border-radius: 12px;
      padding: 8px 18px;
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .showroom-back-btn:hover {
      background: var(--brut-yellow);
      transform: translate(-1.5px, -1.5px);
      box-shadow: 4px 4px 0 #000;
    }
    .showroom-back-btn:active {
      transform: translate(1.5px, 1.5px);
      box-shadow: 1.5px 1.5px 0 #000;
    }

    .showroom-title-cluster {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .showroom-badge-tag {
      font-family: var(--font-display);
      font-size: 9.5px;
      font-weight: 900;
      letter-spacing: 1px;
      background: var(--brut-yellow);
      color: #000;
      border: 1.5px solid #000;
      border-radius: 6px;
      padding: 1px 8px;
      box-shadow: 1.5px 1.5px 0 #000;
      text-transform: uppercase;
    }
    .showroom-badge-tag.tag-green {
      background: var(--brut-green);
      color: #fff;
    }
    .showroom-title-main {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #000;
      margin: 0;
      text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .showroom-drag-hint {
      display: flex;
      align-items: center;
      gap: 7px;
      background: rgba(255, 255, 255, 0.92);
      border: 2px solid #000;
      box-shadow: 2px 2px 0 #000;
      border-radius: 20px;
      padding: 5px 14px;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.5px;
      color: #000;
      animation: hintFloat 2.4s ease-in-out infinite alternate;
    }
    @keyframes hintFloat {
      from { transform: translateY(0); }
      to { transform: translateY(-3px); }
    }

    .showroom-top-stats {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .showroom-stat-pill {
      display: flex;
      align-items: center;
      gap: 7px;
      background: var(--brut-white);
      border: var(--brut-border);
      box-shadow: var(--brut-shadow-sm);
      border-radius: 12px;
      padding: 6px 14px;
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 900;
      color: #000;
    }

    /* ── BOTTOM SHOWROOM DOCK ── */
    .showroom-bottom-deck {
      pointer-events: auto;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-top: 3.5px solid #000;
      box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.15);
      padding: 12px 20px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 100;
    }
    .showroom-tabs-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .showroom-tab-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      background: var(--brut-white);
      color: #000;
      border: 2.5px solid #000;
      box-shadow: 2.5px 2.5px 0 #000;
      border-radius: 12px;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.5px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.1s ease;
    }
    .showroom-tab-btn:hover {
      background: #FFFBE6;
      transform: translate(-1px, -1px);
      box-shadow: 3.5px 3.5px 0 #000;
    }
    .showroom-tab-btn.active {
      background: var(--brut-yellow) !important;
      color: #000 !important;
      border-color: #000 !important;
      transform: translate(1px, 1px);
      box-shadow: 1.5px 1.5px 0 #000;
    }
    .showroom-tab-btn .tab-icon {
      font-size: 15px;
    }

    .showroom-shelf-wrap {
      width: 100%;
      overflow: hidden;
    }
    .showroom-shelf-scroll {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 4px 4px 8px;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      scrollbar-color: #000 transparent;
      touch-action: pan-x !important;
      -webkit-overflow-scrolling: touch;
    }
    .showroom-shelf-scroll::-webkit-scrollbar {
      height: 6px;
    }
    .showroom-shelf-scroll::-webkit-scrollbar-thumb {
      background: #000;
      border-radius: 4px;
    }

    /* ── SHOWROOM ITEM CARDS ── */
    .showroom-card {
      flex: 0 0 230px;
      background: #FFFFFF;
      border: 2.5px solid #000;
      box-shadow: 3.5px 3.5px 0 #000;
      border-radius: 14px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      text-align: left;
      cursor: pointer;
      scroll-snap-align: start;
      transition: all 0.12s ease;
      position: relative;
      user-select: none;
    }
    .showroom-card:hover {
      transform: translateY(-2px);
      box-shadow: 5px 5px 0 #000;
    }
    .showroom-card.active-selection,
    .showroom-card.previewing {
      background: #FFFDF0;
      border-color: #000;
      outline: 2.5px solid var(--brut-yellow);
      outline-offset: -2px;
    }
    .showroom-card.equipped {
      background: #F0FDF4;
      border-color: #059669;
    }

    .showroom-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2px;
    }
    .skin-swatch-circle {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #000;
      box-shadow: 1.5px 1.5px 0 #000;
    }
    .machine-color-badge {
      width: 20px;
      height: 20px;
      border-radius: 6px;
      border: 2px solid #000;
      box-shadow: 1.5px 1.5px 0 #000;
    }

    .showroom-card-title {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 0.5px;
      color: #000;
      line-height: 1.15;
    }
    .showroom-card-subtitle {
      font-size: 9.5px;
      font-weight: 800;
      color: #0284c7;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .showroom-card-desc {
      font-size: 10px;
      font-weight: 600;
      color: #475569;
      line-height: 1.25;
      min-height: 26px;
    }
    .showroom-card-hint {
      font-size: 8.5px;
      font-weight: 900;
      color: #64748b;
      letter-spacing: 0.5px;
    }

    .machine-specs-bars {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin: 2px 0 4px;
    }
    .spec-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 8.5px;
      font-weight: 900;
      color: #000;
    }
    .spec-bar-track {
      width: 140px;
      height: 6px;
      background: #e2e8f0;
      border: 1px solid #000;
      border-radius: 3px;
      overflow: hidden;
    }
    .spec-bar-fill {
      height: 100%;
      background: var(--brut-yellow);
      border-radius: 2px;
    }

    .showroom-action-btn {
      width: 100%;
      padding: 6px 10px;
      font-size: 11.5px;
      font-weight: 900;
      margin-top: 3px;
    }

    @media (max-width: 768px) {
      .showroom-top-bar {
        padding: 10px 14px;
      }
      .showroom-drag-hint {
        display: none;
      }
      .showroom-title-main {
        font-size: 16px;
      }
      .showroom-card {
        flex: 0 0 195px;
        padding: 8px 10px;
      }
      .spec-bar-track {
        width: 110px;
      }
    }
    @media (max-height: 500px) {
      .showroom-top-bar {
        padding: 6px 12px;
      }
      .showroom-bottom-deck {
        padding: 6px 14px 8px;
        gap: 6px;
      }
      .showroom-tab-btn {
        padding: 4px 12px;
        font-size: 11px;
      }
      .showroom-card {
        flex: 0 0 180px;
        padding: 6px 8px;
        gap: 3px;
      }
      .showroom-card-desc {
        display: none;
      }
    }

    /* ── ARCADE REWARDED AD PLAYER OVERLAY ── */
    .ad-player-card {
      background: #0f172a;
      color: #FFF;
      border: 4px solid #000;
      box-shadow: 10px 10px 0 #000;
      border-radius: 20px;
      padding: 20px;
      max-width: 440px;
      width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
    }
    .ad-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .ad-badge-live {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 900;
      color: #00f0ff;
      background: rgba(0, 240, 255, 0.15);
      border: 1.5px solid #00f0ff;
      padding: 2px 8px;
      border-radius: 6px;
    }
    .ad-live-dot {
      color: #ff0055;
      animation: liveBlink 1s infinite alternate;
    }
    .ad-countdown-pill {
      background: #ffe600;
      color: #000;
      font-family: var(--font-digital);
      font-size: 16px;
      font-weight: 900;
      padding: 2px 10px;
      border-radius: 8px;
      border: 2px solid #000;
    }
    .ad-video-mockup {
      background: #1e293b;
      border: 2.5px solid #334155;
      border-radius: 14px;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .ad-sponsor-icon {
      font-size: 52px;
      filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.5));
      animation: pulseBounce 1.2s infinite ease-in-out;
    }
    .ad-sponsor-title {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 900;
      color: #FFF;
      letter-spacing: 0.5px;
    }
    .ad-sponsor-desc {
      font-size: 12px;
      color: #94a3b8;
      max-width: 320px;
      line-height: 1.4;
    }
    .ad-progress-bar-bg {
      width: 100%;
      height: 8px;
      background: #0f172a;
      border-radius: 6px;
      overflow: hidden;
      border: 1.5px solid #334155;
      margin-top: 6px;
    }
    .ad-progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #00f0ff, #ffe600);
      transition: width 1s linear;
    }
    .ad-bottom-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }
    .footer-links-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .footer-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      text-decoration: none;
      background: #FFFFFF;
      border: 2px solid #000;
      box-shadow: 2.5px 2.5px 0 #000;
      border-radius: 10px;
      padding: 4px 10px;
      font-family: var(--font-display);
      font-size: 11.5px;
      font-weight: 900;
      color: #000;
      cursor: pointer;
      transition: all 0.1s ease;
    }
    .footer-link-btn:hover {
      background: #FFF9D2;
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0 #000;
    }
    .footer-link-btn:active {
      transform: translate(1px, 1px);
      box-shadow: 1px 1px 0 #000;
    }
    .footer-dot {
      color: #334155;
      font-weight: 900;
      font-size: 14px;
    }
    .footer-badge-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .version-tag, .studio-tag {
      font-family: var(--font-display);
      font-size: 10.5px;
      font-weight: 800;
      color: #0f172a;
      background: rgba(255, 255, 255, 0.7);
      border: 1.5px solid #000;
      border-radius: 6px;
      padding: 2px 8px;
    }

    /* ── POPUP MODALS (Privacy, Terms, Guide, Daily Gift) ── */
    .policy-card {
      max-width: 540px;
      width: 100%;
      background: #FFFDF5;
      border: 3.5px solid #000;
      box-shadow: 8px 8px 0px #000;
      border-radius: 20px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .policy-content-scroll {
      overflow-y: auto;
      max-height: 54vh;
      padding-right: 6px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .policy-section {
      background: #FFFFFF;
      border: 2px solid #000;
      box-shadow: 2px 2px 0px #000;
      border-radius: 12px;
      padding: 12px;
    }
    .policy-section h4 {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 800;
      color: #000;
      margin-bottom: 4px;
    }
    .policy-section p {
      font-size: 12px;
      line-height: 1.5;
      color: #334155;
      font-weight: 600;
    }

    .controls-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .ctrl-card {
      background: #FFFFFF;
      border: 2px solid #000;
      box-shadow: 2px 2px 0px #000;
      border-radius: 10px;
      padding: 8px 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ctrl-key-badge {
      background: var(--brut-yellow);
      border: 1.5px solid #000;
      border-radius: 6px;
      padding: 2px 7px;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 900;
      color: #000;
      white-space: nowrap;
    }
    .ctrl-desc {
      font-size: 11.5px;
      font-weight: 800;
      color: #1e293b;
    }

    /* Daily Gift Card Visuals */
    .gift-chest-card {
      max-width: 440px;
      text-align: center;
    }
    .chest-center-visual {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 10px 0;
    }
    .chest-bouncing-icon {
      font-size: 64px;
      filter: drop-shadow(4px 4px 0 #000);
      animation: pulseBounce 1.4s infinite ease-in-out;
    }
    .chest-title {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      color: #000;
      letter-spacing: 0.5px;
    }
    .chest-desc {
      font-size: 13px;
      font-weight: 700;
      color: #475569;
      max-width: 320px;
    }
    .reward-loot-row {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 10px;
      width: 100%;
    }
    .loot-item {
      flex: 1;
      background: #FFF;
      border: 2.5px solid #000;
      box-shadow: 3px 3px 0 #000;
      border-radius: 12px;
      padding: 8px 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .loot-icon { font-size: 24px; }
    .loot-val {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 900;
      color: #000;
    }
    .hero-claim-btn {
      font-family: var(--font-display);
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <!-- High-End Pro Racing Loading Screen with Spinning Alloy Wheel & RPM Tachometer -->
  <div id="loading-screen">
    <div class="loader-card">
      <!-- AIRSKID SVG Logo (Matching User Reference Image 1:1) -->
      <div class="loader-logo-wrap">
        <svg viewBox="0 0 760 200" style="width: 100%; height: auto; overflow: visible;">
          <defs>
            <linearGradient id="loadSkyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#1D4ED8" stop-opacity="0.95"/>
            </linearGradient>
            <linearGradient id="loadAirGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FFFFFF"/>
              <stop offset="35%" stop-color="#E0F7FF"/>
              <stop offset="70%" stop-color="#38BDF8"/>
              <stop offset="100%" stop-color="#0284C7"/>
            </linearGradient>
            <linearGradient id="loadSkidGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FFF544"/>
              <stop offset="45%" stop-color="#FFBE0B"/>
              <stop offset="85%" stop-color="#FB8500"/>
              <stop offset="100%" stop-color="#D97706"/>
            </linearGradient>
            <filter id="loadDrop" x="-15%" y="-15%" width="130%" height="130%">
              <feDropShadow dx="0" dy="8" stdDeviation="5" flood-color="#020617" flood-opacity="0.9"/>
            </filter>
          </defs>

          <!-- 1. Background Sky Clouds & Speed Dashes -->
          <g filter="url(#loadDrop)">
            <path d="M 180,32 L 290,32" stroke="#38BDF8" stroke-width="7" stroke-linecap="round"/>
            <path d="M 230,46 L 310,46" stroke="#38BDF8" stroke-width="5" stroke-linecap="round"/>
            <path d="M 140,58 L 220,58" stroke="#38BDF8" stroke-width="6" stroke-linecap="round"/>
            <path d="M 310,64 C 315,36 345,20 375,32 C 395,14 435,14 458,34 C 480,24 515,32 525,54 C 540,56 550,68 550,82 L 295,82 C 295,72 302,66 310,64 Z" 
                  fill="url(#loadSkyGrad)" stroke="#09142B" stroke-width="5" stroke-linejoin="round"/>
            <path d="M 330,46 C 345,30 368,28 382,36" fill="none" stroke="#BAE6FD" stroke-width="4.5" stroke-linecap="round"/>
            <path d="M 405,24 C 425,18 448,22 458,34" fill="none" stroke="#BAE6FD" stroke-width="4.5" stroke-linecap="round"/>
          </g>

          <!-- 2. Dark Chevron Backplate for SKID with Checkered Flag -->
          <g filter="url(#loadDrop)">
            <polygon points="345,64 715,64 680,162 310,162" fill="#080F21" stroke="#000000" stroke-width="7" stroke-linejoin="round"/>
            <polygon points="352,70 706,70 674,156 320,156" fill="none" stroke="#1E293B" stroke-width="2.5"/>
            <!-- Checkered Flag Grid -->
            <polygon points="620,72 648,72 641,98 613,98" fill="#00E5FF"/>
            <polygon points="613,98 641,98 634,124 606,124" fill="#080F21"/>
            <polygon points="606,124 634,124 627,150 599,150" fill="#00E5FF"/>
            <polygon points="648,72 676,72 669,98 641,98" fill="#080F21"/>
            <polygon points="641,98 669,98 662,124 634,124" fill="#00E5FF"/>
            <polygon points="634,124 662,124 655,150 627,150" fill="#080F21"/>
            <polygon points="676,72 702,72 695,98 669,98" fill="#00E5FF"/>
            <polygon points="669,98 695,98 688,124 662,124" fill="#080F21"/>
            <polygon points="662,124 688,124 681,150 655,150" fill="#00E5FF"/>
          </g>

          <!-- 3. SKID Typography -->
          <g filter="url(#loadDrop)">
            <text x="365" y="146" font-family="'Rajdhani', sans-serif" font-size="94" font-weight="900" font-style="italic"
                  fill="url(#loadSkidGrad)" stroke="#060C1B" stroke-width="12" stroke-linejoin="round" letter-spacing="3" paint-order="stroke fill">
              SKID
            </text>
            <text x="365" y="146" font-family="'Rajdhani', sans-serif" font-size="94" font-weight="900" font-style="italic"
                  fill="url(#loadSkidGrad)" letter-spacing="3">
              SKID
            </text>
          </g>

          <!-- 4. AIR Typography with Extended Aerodynamic Jet Wing -->
          <g filter="url(#loadDrop)">
            <polygon points="35,138 215,138 240,118 190,118 140,118 45,130" fill="#051026" stroke="#051026" stroke-width="6" stroke-linejoin="round"/>
            <polygon points="40,136 210,136 235,120 188,120 138,120 48,129" fill="url(#loadAirGrad)"/>
            <polygon points="50,131 205,131 190,123 70,123" fill="#FFFFFF" opacity="0.85"/>
            <text x="120" y="146" font-family="'Rajdhani', sans-serif" font-size="108" font-weight="900" font-style="italic"
                  fill="url(#loadAirGrad)" stroke="#051026" stroke-width="14" stroke-linejoin="round" letter-spacing="-1" paint-order="stroke fill">
              AIR
            </text>
            <text x="120" y="146" font-family="'Rajdhani', sans-serif" font-size="108" font-weight="900" font-style="italic"
                  fill="url(#loadAirGrad)" letter-spacing="-1">
              AIR
            </text>
          </g>

          <!-- 5. Tagline -->
          <g>
            <line x1="205" y1="184" x2="275" y2="184" stroke="#00E5FF" stroke-width="3" stroke-linecap="round"/>
            <text x="390" y="189" font-family="'Rajdhani', sans-serif" font-size="16" font-weight="800" fill="#F8FAFC" letter-spacing="6" text-anchor="middle">
              RACE BEYOND LIMITS
            </text>
            <line x1="505" y1="184" x2="575" y2="184" stroke="#00E5FF" stroke-width="3" stroke-linecap="round"/>
          </g>
        </svg>
      </div>

      <!-- Rotating Racing Alloy Wheel Assembly with Burnout Smoke & Caliper -->
      <div class="loader-wheel-stage">
        <svg viewBox="0 0 200 200">
          <defs>
            <radialGradient id="loadTireRubber" cx="50%" cy="50%" r="50%">
              <stop offset="70%" stop-color="#18181B"/>
              <stop offset="90%" stop-color="#27272A"/>
              <stop offset="100%" stop-color="#09090B"/>
            </radialGradient>
            <linearGradient id="loadRimAlloy" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFFFFF"/>
              <stop offset="40%" stop-color="#CBD5E1"/>
              <stop offset="70%" stop-color="#64748B"/>
              <stop offset="100%" stop-color="#334155"/>
            </linearGradient>
            <linearGradient id="loadCaliperRed" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FF385C"/>
              <stop offset="100%" stop-color="#B91C1C"/>
            </linearGradient>
          </defs>

          <!-- Burnout Smoke Puffs (Contact Patch) -->
          <g class="smoke-puff-left">
            <circle cx="85" cy="180" r="16" fill="#F1F5F9" opacity="0.6"/>
            <circle cx="70" cy="175" r="12" fill="#E2E8F0" opacity="0.5"/>
          </g>
          <g class="smoke-puff-right">
            <circle cx="115" cy="180" r="16" fill="#F1F5F9" opacity="0.6"/>
            <circle cx="130" cy="175" r="12" fill="#E2E8F0" opacity="0.5"/>
          </g>
          <!-- Friction Sparks -->
          <circle cx="95" cy="182" r="3" fill="#FBBF24" class="burnout-spark"/>
          <circle cx="108" cy="184" r="2.5" fill="#F97316" class="burnout-spark"/>

          <!-- Outer Slick Rubber Tire -->
          <circle cx="100" cy="100" r="86" fill="url(#loadTireRubber)" stroke="#000" stroke-width="4"/>
          <circle cx="100" cy="100" r="62" fill="#09090B" stroke="#27272A" stroke-width="2"/>

          <!-- Slotted Cross-Drilled Steel Brake Rotor -->
          <circle cx="100" cy="100" r="54" fill="#3F3F46" stroke="#52525B" stroke-width="1.5"/>
          <circle cx="90" cy="65" r="1.5" fill="#18181B"/>
          <circle cx="110" cy="65" r="1.5" fill="#18181B"/>
          <circle cx="135" cy="90" r="1.5" fill="#18181B"/>
          <circle cx="135" cy="110" r="1.5" fill="#18181B"/>
          <circle cx="90" cy="135" r="1.5" fill="#18181B"/>
          <circle cx="110" cy="135" r="1.5" fill="#18181B"/>
          <circle cx="65" cy="90" r="1.5" fill="#18181B"/>
          <circle cx="65" cy="110" r="1.5" fill="#18181B"/>

          <!-- Static High-Performance Brembo-Red Racing Brake Caliper -->
          <g transform="rotate(-38 100 100)">
            <path d="M 52,70 C 52,60 62,54 75,54 L 115,54 C 122,54 128,58 130,64 L 122,86 C 118,88 72,88 64,84 Z" 
                  fill="url(#loadCaliperRed)" stroke="#7F1D1D" stroke-width="2.5"/>
            <text x="92" y="74" font-family="'Rajdhani', sans-serif" font-size="10" font-weight="900" fill="#FFF" letter-spacing="1" text-anchor="middle">
              AIRSKID
            </text>
          </g>

          <!-- Spinning 5-Spoke Sport Alloy Rim -->
          <g class="spinning-rim">
            <circle cx="100" cy="100" r="60" fill="none" stroke="url(#loadRimAlloy)" stroke-width="3"/>
            <circle cx="100" cy="100" r="50" fill="none" stroke="#475569" stroke-width="1"/>
            <!-- 5 Twin-Spokes -->
            <polygon points="94,100 106,100 104,42 96,42" fill="url(#loadRimAlloy)" stroke="#1E293B" stroke-width="1.5"/>
            <g transform="rotate(72 100 100)">
              <polygon points="94,100 106,100 104,42 96,42" fill="url(#loadRimAlloy)" stroke="#1E293B" stroke-width="1.5"/>
            </g>
            <g transform="rotate(144 100 100)">
              <polygon points="94,100 106,100 104,42 96,42" fill="url(#loadRimAlloy)" stroke="#1E293B" stroke-width="1.5"/>
            </g>
            <g transform="rotate(216 100 100)">
              <polygon points="94,100 106,100 104,42 96,42" fill="url(#loadRimAlloy)" stroke="#1E293B" stroke-width="1.5"/>
            </g>
            <g transform="rotate(288 100 100)">
              <polygon points="94,100 106,100 104,42 96,42" fill="url(#loadRimAlloy)" stroke="#1E293B" stroke-width="1.5"/>
            </g>
            <!-- Center Hex Lug Nut -->
            <circle cx="100" cy="100" r="16" fill="#0F172A" stroke="#94A3B8" stroke-width="2"/>
            <polygon points="100,90 109,95 109,105 100,110 91,105 91,95" fill="#F59E0B" stroke="#78350F" stroke-width="1.5"/>
            <circle cx="100" cy="100" r="3.5" fill="#00E5FF"/>
          </g>
        </svg>
      </div>

      <!-- RPM Tachometer Rev Meter Bar -->
      <div class="loader-rpm-dashboard">
        <div class="rpm-meter-cluster">
          <span class="rpm-label">REV</span>
          <div class="rpm-segment green active"></div>
          <div class="rpm-segment green active"></div>
          <div class="rpm-segment green active"></div>
          <div class="rpm-segment green active"></div>
          <div class="rpm-segment yellow active"></div>
          <div class="rpm-segment yellow active"></div>
          <div class="rpm-segment yellow"></div>
          <div class="rpm-segment red"></div>
          <div class="rpm-segment red"></div>
          <div class="rpm-segment red"></div>
        </div>
        <div class="rpm-digital-val" id="loader-rpm-val">6,200 RPM</div>
        <div class="rpm-pct-val" id="loader-pct-val">60%</div>
      </div>

      <!-- Precision Angled Loading Bar -->
      <div class="loader-bar-bg">
        <div class="loader-bar-fill" id="loader-bar-fill" style="width: 60%;"></div>
      </div>

      <div class="loader-status" id="loader-status">INITIALIZING RAPID PHYSICS ENGINE (WASM)...</div>
      <div class="loader-tap-hint" id="loader-tap-hint" style="display: none;">ENTER PITLANE // TAP TO PLAY</div>
    </div>
  </div>

  <!-- 3D WebGL Canvas -->
  <canvas id="game-canvas"></canvas>

  <!-- Tactical Nitro Speedlines Canvas (Deadshot.io Style Wind Rush Streaks) -->
  <canvas id="speedlines-canvas" style="position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 6; display: block;"></canvas>

  <!-- In-Game Neo-Brutalist HUD -->
  <div id="hud-container">
    <!-- Top Status & Audio Bar (In-Game Only) -->
    <div id="top-bar">
      <button id="sound-toggle">AUDIO: ON</button>
      <div id="room-badge">ROOM: ----</div>
    </div>

    <!-- Top-Left Status -->
    <div class="top-left-hud">
      <div class="pos-badge" id="hud-pos">1ST</div>
      <div class="lap-box">
        <div class="lap-title">LAP</div>
        <div class="lap-num" id="hud-lap">1/3</div>
      </div>
      <div class="lap-box">
        <div class="lap-title">TIME</div>
        <div class="lap-num" id="hud-time">00:00.0</div>
      </div>
    </div>

    <!-- Top-Right Minimap -->
    <div class="top-right-hud">
      <div class="minimap-card">
        <div class="minimap-title">RADAR // MAP</div>
        <canvas id="minimap-canvas" width="260" height="260"></canvas>
      </div>
    </div>

    <!-- Live Standings & Laps Card -->
    <div class="live-standings-card" id="live-standings-card">
      <div class="standings-title">STANDINGS // LAPS</div>
      <div class="standings-list" id="standings-list">
        <!-- populated dynamically -->
      </div>
    </div>

    <!-- Rumble Top Scoreboard Bar -->
    <div class="rumble-hud-bar" id="rumble-hud-bar" style="display: none;">
      <div class="rumble-team-box cyan-box">
        <span class="team-glow-indicator cyan-indicator"></span>
        <span class="rumble-team-name">CYAN</span>
        <span class="rumble-team-score" id="rumble-cyan-score">0</span>
      </div>
      <div class="rumble-center-badge">
        <div class="rumble-match-title" id="rumble-match-title">TEAM DEATHMATCH</div>
        <div class="rumble-timer-display" id="rumble-timer-display">FIRST TO 10</div>
      </div>
      <div class="rumble-team-box crimson-box">
        <span class="rumble-team-score" id="rumble-crimson-score">0</span>
        <span class="rumble-team-name">CRIMSON</span>
        <span class="team-glow-indicator crimson-indicator"></span>
      </div>
    </div>

    <!-- Live Killfeed Toast Stack -->
    <div class="killfeed-container" id="killfeed-container" style="display: none;"></div>

    <!-- Bottom-Right Speedometer & Nitro HUD -->
    <div class="speedo-container">
      <div class="speedo-digits-col">
        <div class="speed-value" id="hud-speed">0</div>
        <div class="speed-unit">KM / H</div>
      </div>
      <div class="nitro-card">
        <div class="nitro-card-header">
          <span class="nitro-card-title">⚡ NITRO</span>
          <span class="nitro-card-count" id="hud-nitro-count">3/3</span>
          <span class="nitro-card-hint">[SPACE]</span>
        </div>
        <div class="nitro-pips-container" id="hud-nitro-pips">
          <div class="nitro-pip active" id="nitro-pip-1"></div>
          <div class="nitro-pip active" id="nitro-pip-2"></div>
          <div class="nitro-pip active" id="nitro-pip-3"></div>
        </div>
        <div class="nitro-bar-container">
          <div class="nitro-fill" id="hud-nitro"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Screen Alerts (Stickers) -->
  <div id="alert-banner"></div>
  <div id="countdown-overlay">3</div>
  <div id="wrong-way-banner">⚠️ WRONG WAY // TURN AROUND! ⚠️</div>

  <!-- Finish Countdown Banner (Top Center) -->
  <div id="finish-countdown-banner">
    <span>⏱️</span>
    <span>RACE ENDING IN: <strong id="finish-countdown-sec">20</strong>s</span>
  </div>

  <!-- Spectator Mode Overlay -->
  <div id="spectator-overlay">
    <div class="spectator-badge">
      <span class="spectator-live-dot">●</span>
      <span>SPECTATING: <strong id="spectator-target-name">RACER</strong></span>
      <span id="spectator-target-pos" class="spectator-pos-tag">#2</span>
    </div>
    <div class="spectator-controls">
      <button type="button" class="spectator-btn" id="spectator-prev">◀ PREV</button>
      <button type="button" class="spectator-btn" id="spectator-next">NEXT ▶</button>
    </div>
  </div>

  <!-- Mobile Touch Controls (NFS / Asphalt Mobile Arcade Style) -->
  <div id="touch-controls">
    <!-- Left: Dual Steering Buttons (◀ LEFT and ▶ RIGHT) -->
    <div class="touch-steer-cluster" id="touch-steer-cluster">
      <button type="button" class="touch-ctrl-btn btn-steer" id="touch-btn-left">
        <span class="ctrl-icon">◀</span>
        <span class="ctrl-sub">LEFT</span>
      </button>
      <button type="button" class="touch-ctrl-btn btn-steer" id="touch-btn-right">
        <span class="ctrl-icon">▶</span>
        <span class="ctrl-sub">RIGHT</span>
      </button>
    </div>

    <!-- Right: Action Cluster with Square Gas, Square Brake, Drift & Reset -->
    <div class="touch-action-cluster" id="touch-action-cluster">
      <div class="touch-top-action-row" style="justify-content: flex-end; width: 100%;">
        <button type="button" class="touch-ctrl-btn btn-nitro" id="touch-btn-nitro">
          <span class="ctrl-icon-sm">⚡</span>
          <span class="ctrl-label" id="touch-nitro-label">NITRO (3)</span>
        </button>
      </div>
      <div class="touch-pedal-row">
        <button type="button" class="touch-ctrl-btn btn-brake-square" id="touch-btn-brake">
          <span class="ctrl-icon">▼</span>
          <span class="ctrl-label">BRAKE</span>
        </button>
        <button type="button" class="touch-ctrl-btn btn-gas-square" id="touch-btn-gas">
          <span class="ctrl-icon-gas">▲</span>
          <span class="ctrl-label-gas">GAS</span>
          <div class="gas-pedal-grooves">
            <span></span><span></span><span></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- 3D SHOWROOM LOBBY HUD (High-Octane Racer Aesthetic // ZERO EMOJIS) -->
  <div id="start-menu-modal">
    <!-- Sky Speedlines & Atmospheric Wind FX -->
    <div class="sky-speed-streaks">
      <div class="speed-streak streak-1"></div>
      <div class="speed-streak streak-2"></div>
      <div class="speed-streak streak-3"></div>
      <div class="speed-streak streak-4"></div>
    </div>

    <!-- Top Header Bar: Player Profile & VIP on Left, Tools & Economy on Right -->
    <div class="lobby-top-bar">
      <!-- Left: Player Profile, Fuel/XP Progress & VIP Badge -->
      <div class="lobby-user-cluster">
        <div class="lobby-callsign-box">
          <svg viewBox="0 0 24 24" width="14" height="14" class="racer-tag-svg" style="fill: #1e40af;"><path d="M12 2C7 2 3 6 3 11c0 3 1.5 5.5 3.5 7L6 21l3-1c1 .3 2 .5 3 .5 5 0 9-4 9-9.5S17 2 12 2z"/></svg>
          <span class="callsign-label">PILOT:</span>
          <input type="text" class="callsign-input" id="player-name-input" value="SPEEDSTER" maxlength="12" placeholder="YOUR NAME" />
        </div>
        <div class="lobby-level-box" title="Racer Level & Fuel Tank XP Progress">
          <span id="level-badge-display" class="lobby-level-pill">LVL 1</span>
          <div class="lobby-xp-track" title="XP progress towards next level">
            <div id="xp-bar-fill" class="lobby-xp-fill" style="width: 40%;"></div>
          </div>
        </div>
        <button type="button" class="lobby-vip-badge" id="lobby-vip-badge" title="VIP Status & 1.5x Boosters">
          <svg viewBox="0 0 24 24" width="15" height="15" style="fill: #000;"><path d="M2 19h20v2H2v-2zm1-5l4-3 5 6 5-6 4 3-2-9-5 3-4-5-4 5-5-3-2 9z"/></svg>
          <span class="vip-text">VIP PASS</span>
        </button>
      </div>

      <!-- Right: Currencies, Daily Gift, Store & Utility Controls -->
      <div class="lobby-currencies-cluster">
        <div class="currency-pill coin-pill" id="btn-open-coins" title="Your Coins - Click to Open Garage Store!">
          <svg viewBox="0 0 24 24" width="18" height="18" class="racer-currency-svg"><circle cx="12" cy="12" r="10" fill="#FFDE59" stroke="#000" stroke-width="2"/><circle cx="12" cy="12" r="7" fill="#F59E0B" stroke="#000" stroke-width="1.5"/><polygon points="12,6.5 13.7,10 17.5,10.5 14.7,13.2 15.4,17 12,15.2 8.6,17 9.3,13.2 6.5,10.5 10.3,10" fill="#FFF"/></svg>
          <span id="coin-amount-display" class="currency-val">1,500</span>
          <span class="currency-plus">+</span>
        </div>
        <div class="currency-pill gem-pill" id="btn-open-gems" title="Your Gems - Click to Open Garage Store!">
          <svg viewBox="0 0 24 24" width="18" height="18" class="racer-currency-svg"><polygon points="6,4 18,4 22,9 12,21 2,9" fill="#00D2FF" stroke="#000" stroke-width="2"/><polygon points="6,4 18,4 15,9 9,9" fill="#E0F7FA"/><polygon points="9,9 15,9 12,21" fill="#0284C7"/></svg>
          <span id="gem-amount-display" class="currency-val">45</span>
          <span class="currency-plus">+</span>
        </div>
        <button type="button" class="lobby-icon-btn gift-btn" id="btn-daily-gift" title="Claim Daily Free Reward Drop!">
          <svg viewBox="0 0 24 24" width="20" height="20" class="racer-btn-icon-svg"><path d="M4 8h16v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8z" fill="#FF385C" stroke="#000" stroke-width="2"/><rect x="2" y="4" width="20" height="4" rx="1" fill="#FFDE59" stroke="#000" stroke-width="2"/><line x1="12" y1="4" x2="12" y2="22" stroke="#000" stroke-width="2"/></svg>
          <span class="gift-badge-dot pulse-anim" id="daily-gift-badge">FREE</span>
        </button>
        <button type="button" class="lobby-icon-btn" id="sound-toggle-btn" title="Toggle Audio (Mute / Unmute)">
          <svg viewBox="0 0 24 24" width="20" height="20" class="racer-btn-icon-svg" id="sound-icon-svg"><polygon points="4,9 8,9 14,4 14,20 8,15 4,15" fill="#000"/><path d="M17 8c1.5 2 1.5 6 0 8" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="lobby-icon-btn" id="fullscreen-btn" title="Toggle Fullscreen">
          <svg viewBox="0 0 24 24" width="18" height="18" class="racer-btn-icon-svg"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="#000" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="lobby-icon-btn" id="btn-open-guide" title="Controls & How to Play">
          <svg viewBox="0 0 24 24" width="20" height="20" class="racer-btn-icon-svg"><rect x="2" y="6" width="20" height="12" rx="6" fill="#FFF" stroke="#000" stroke-width="2"/><line x1="7" y1="12" x2="11" y2="12" stroke="#000" stroke-width="2" stroke-linecap="round"/><line x1="9" y1="10" x2="9" y2="14" stroke="#000" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="10.5" r="1.5" fill="#FF385C"/><circle cx="18" cy="13.5" r="1.5" fill="#00D2FF"/></svg>
        </button>
      </div>
    </div>

    <!-- Center Stage Top: AUTHENTIC AIRSKID Game Logo (1:1 Reference Match) -->
    <div class="lobby-center-branding">
      <svg class="airskid-brand-svg" viewBox="0 0 760 200">
        <defs>
          <linearGradient id="brandSkyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#1D4ED8" stop-opacity="0.95"/>
          </linearGradient>
          <linearGradient id="brandAirGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF"/>
            <stop offset="35%" stop-color="#E0F7FF"/>
            <stop offset="70%" stop-color="#38BDF8"/>
            <stop offset="100%" stop-color="#0284C7"/>
          </linearGradient>
          <linearGradient id="brandSkidGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFF544"/>
            <stop offset="45%" stop-color="#FFBE0B"/>
            <stop offset="85%" stop-color="#FB8500"/>
            <stop offset="100%" stop-color="#D97706"/>
          </linearGradient>
          <filter id="brandDrop" x="-15%" y="-15%" width="130%" height="130%">
            <feDropShadow dx="0" dy="8" stdDeviation="5" flood-color="#020617" flood-opacity="0.9"/>
          </filter>
        </defs>

        <!-- 1. Background Sky Clouds & Speed Dashes -->
        <g filter="url(#brandDrop)">
          <path d="M 180,32 L 290,32" stroke="#38BDF8" stroke-width="7" stroke-linecap="round"/>
          <path d="M 230,46 L 310,46" stroke="#38BDF8" stroke-width="5" stroke-linecap="round"/>
          <path d="M 140,58 L 220,58" stroke="#38BDF8" stroke-width="6" stroke-linecap="round"/>
          <path d="M 310,64 C 315,36 345,20 375,32 C 395,14 435,14 458,34 C 480,24 515,32 525,54 C 540,56 550,68 550,82 L 295,82 C 295,72 302,66 310,64 Z" 
                fill="url(#brandSkyGrad)" stroke="#09142B" stroke-width="5" stroke-linejoin="round"/>
          <path d="M 330,46 C 345,30 368,28 382,36" fill="none" stroke="#BAE6FD" stroke-width="4.5" stroke-linecap="round"/>
          <path d="M 405,24 C 425,18 448,22 458,34" fill="none" stroke="#BAE6FD" stroke-width="4.5" stroke-linecap="round"/>
        </g>

        <!-- 2. Dark Chevron Backplate for SKID with Checkered Flag -->
        <g filter="url(#brandDrop)">
          <polygon points="345,64 715,64 680,162 310,162" fill="#080F21" stroke="#000000" stroke-width="7" stroke-linejoin="round"/>
          <polygon points="352,70 706,70 674,156 320,156" fill="none" stroke="#1E293B" stroke-width="2.5"/>
          <!-- Checkered Flag Grid (Right Wing of SKID Plate) -->
          <polygon points="620,72 648,72 641,98 613,98" fill="#00E5FF"/>
          <polygon points="613,98 641,98 634,124 606,124" fill="#080F21"/>
          <polygon points="606,124 634,124 627,150 599,150" fill="#00E5FF"/>
          <polygon points="648,72 676,72 669,98 641,98" fill="#080F21"/>
          <polygon points="641,98 669,98 662,124 634,124" fill="#00E5FF"/>
          <polygon points="634,124 662,124 655,150 627,150" fill="#080F21"/>
          <polygon points="676,72 702,72 695,98 669,98" fill="#00E5FF"/>
          <polygon points="669,98 695,98 688,124 662,124" fill="#080F21"/>
          <polygon points="662,124 688,124 681,150 655,150" fill="#00E5FF"/>
        </g>

        <!-- 3. SKID Typography (Bold, Geometric, Golden-Yellow Speed Blocks) -->
        <g filter="url(#brandDrop)">
          <text x="365" y="146" font-family="'Rajdhani', sans-serif" font-size="94" font-weight="900" font-style="italic"
                fill="url(#brandSkidGrad)" stroke="#060C1B" stroke-width="12" stroke-linejoin="round" letter-spacing="3" paint-order="stroke fill">
            SKID
          </text>
          <text x="365" y="146" font-family="'Rajdhani', sans-serif" font-size="94" font-weight="900" font-style="italic"
                fill="url(#brandSkidGrad)" letter-spacing="3">
            SKID
          </text>
        </g>

        <!-- 4. AIR Typography with Extended Aerodynamic Jet Wing -->
        <g filter="url(#brandDrop)">
          <polygon points="35,138 215,138 240,118 190,118 140,118 45,130" fill="#051026" stroke="#051026" stroke-width="6" stroke-linejoin="round"/>
          <polygon points="40,136 210,136 235,120 188,120 138,120 48,129" fill="url(#brandAirGrad)"/>
          <polygon points="50,131 205,131 190,123 70,123" fill="#FFFFFF" opacity="0.85"/>
          <text x="120" y="146" font-family="'Rajdhani', sans-serif" font-size="108" font-weight="900" font-style="italic"
                fill="url(#brandAirGrad)" stroke="#051026" stroke-width="14" stroke-linejoin="round" letter-spacing="-1" paint-order="stroke fill">
            AIR
          </text>
          <text x="120" y="146" font-family="'Rajdhani', sans-serif" font-size="108" font-weight="900" font-style="italic"
                fill="url(#brandAirGrad)" letter-spacing="-1">
            AIR
          </text>
        </g>

        <!-- 5. Tagline: — RACE BEYOND LIMITS — -->
        <g>
          <line x1="205" y1="184" x2="275" y2="184" stroke="#00E5FF" stroke-width="3" stroke-linecap="round"/>
          <text x="390" y="189" font-family="'Rajdhani', sans-serif" font-size="16" font-weight="800" fill="#F8FAFC" letter-spacing="6" text-anchor="middle">
            RACE BEYOND LIMITS
          </text>
          <line x1="505" y1="184" x2="575" y2="184" stroke="#00E5FF" stroke-width="3" stroke-linecap="round"/>
        </g>
      </svg>
    </div>

    <!-- Floating Arcade Carousel Switch Arrows (Aerodynamic Steering Paddles) -->
    <button type="button" class="garage-arrow-btn garage-arrow-left" id="btn-kart-prev" title="Previous Machine">
      <svg viewBox="0 0 24 24" class="arrow-icon-svg"><polyline points="15 6 9 12 15 18"/></svg>
    </button>
    <button type="button" class="garage-arrow-btn garage-arrow-right" id="btn-kart-next" title="Next Machine">
      <svg viewBox="0 0 24 24" class="arrow-icon-svg"><polyline points="9 6 15 12 9 18"/></svg>
    </button>

    <!-- Left Flank: Garage Showroom & Customizer Dock (Asphalt / Brawl Stars Style) -->
    <div class="lobby-left-dock" id="lobby-left-dock">
      <button type="button" class="lobby-shop-banner-btn" id="btn-open-store" title="Open 3D Garage Showroom & Livery Customizer">
        <div class="shop-banner-icon-box">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#000" style="vertical-align: middle;">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </div>
        <div class="shop-banner-text-col">
          <div class="shop-banner-title-row">
            <span class="shop-banner-title">GARAGE SHOP</span>
            <span class="shop-banner-pill pulse-anim">3D SKINS</span>
          </div>
          <span class="shop-banner-subtitle">LIVERIES • TUNING • VIP</span>
        </div>
        <div class="shop-banner-arrow-box">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </button>
    </div>

    <!-- Machine Hero Specs Badge: Cockpit Telemetry Pit-Board -->
    <div class="machine-hero-badge" id="machine-hero-badge">
      <div class="telemetry-meta-header">
        <span class="telemetry-dot-blink"></span>
        <span>PIT TELEMETRY // MACHINE SPECS</span>
      </div>
      <div class="machine-hero-title-row">
        <span class="machine-color-dot" id="machine-color-dot" style="background: #ff2244;"></span>
        <span class="machine-name-text" id="machine-name-text">APEX</span>
        <span class="machine-class-tag" id="machine-class-tag">SPEEDSTER</span>
      </div>
      <div class="machine-stats-compact">
        <div class="stat-metric-col" title="Top Speed Rating">
          <svg class="stat-metric-svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 12l4-4"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>
          <span>SPEED</span>
          <span class="mini-stat-bar"><span class="mini-stat-fill" id="stat-bar-speed" style="width: 80%;"></span></span>
        </div>
        <div class="stat-metric-col" title="Chassis Weight & Armor Rating">
          <svg class="stat-metric-svg" viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 9-8 10-4.5-1-8-5-8-10V7l8-4z"/></svg>
          <span>WEIGHT</span>
          <span class="mini-stat-bar"><span class="mini-stat-fill" id="stat-bar-weight" style="width: 55%;"></span></span>
        </div>
        <div class="stat-metric-col" title="Drift Grip & Cornering Angle">
          <svg class="stat-metric-svg" viewBox="0 0 24 24"><path d="M3 17c3-5 7-7 12-7h6M17 6l4 4-4 4"/><circle cx="7" cy="17" r="3"/></svg>
          <span>DRIFT</span>
          <span class="mini-stat-bar"><span class="mini-stat-fill" id="stat-bar-grip" style="width: 65%;"></span></span>
        </div>
      </div>
      <!-- 4 Machine Pips -->
      <div class="kart-dots-row">
        <span class="kart-dot-pip active" data-kart="0" title="APEX"></span>
        <span class="kart-dot-pip" data-kart="1" title="GOLIATH"></span>
        <span class="kart-dot-pip" data-kart="2" title="KITSUNE"></span>
        <span class="kart-dot-pip" data-kart="3" title="VOLT"></span>
      </div>
    </div>

    <!-- Right Flank: Grand Prix Season 1 Pass & Daily Challenge -->
    <div class="lobby-event-card" id="lobby-event-card">
      <div class="event-meta-header">
        <div style="display: flex; align-items: center; gap: 6px;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#FFDE59"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
          <span>CHAMPIONSHIP // S1</span>
        </div>
        <span class="event-tier-pill">SKY GP</span>
      </div>
      <div class="event-bounty-box">
        <div class="bounty-title-row">
          <span class="bounty-title">DAILY BOUNTY // PODIUM</span>
          <span class="bounty-reward-pill">+150 COINS</span>
        </div>
        <div class="bounty-bar-track">
          <div class="bounty-bar-fill" style="width: 50%;"></div>
        </div>
        <div class="bounty-subtext">PROGRESS: 0 / 1 PODIUM WIN</div>
      </div>
      <div class="lobby-tip-banner">
        <span class="tip-bolt">⚡</span>
        <span class="tip-text">PRO TIP: DRAFT BEHIND OPPONENTS FOR SLIPSTREAM BOOST!</span>
      </div>
    </div>

    <!-- Center Bottom: Unified Bottom Deck (Zero Overlap Guaranteed!) -->
    <div class="lobby-bottom-wrapper">
      <div class="lobby-action-hub">
        <!-- Hero Play Button (Opens Fullscreen Mode Select) -->
        <button type="button" class="lobby-hero-play-btn" id="btn-main-play" title="Select Game Mode & Race!">
          <div class="hero-play-icon-bubble">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="#000">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </div>
          <div class="hero-play-text-col">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="hero-play-title">PLAY NOW</span>
              <span class="hero-play-badge">SELECT MODE</span>
            </div>
            <span class="hero-play-subtitle">SOLO GP • SKY RUMBLE • HARDCORE</span>
          </div>
        </button>

        <!-- Quick Multiplayer Shortcut -->
        <button type="button" class="lobby-quick-mp-btn" id="btn-quick-mp" title="Direct Online Multiplayer Lobby">
          <div class="quick-live-dot"></div>
          <div class="quick-mp-text-col">
            <span class="quick-mp-title">MULTIPLAYER</span>
            <span class="quick-mp-subtitle">P2P ROOM // LIVE</span>
          </div>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px;">
            <circle cx="12" cy="18" r="2" fill="#000"/>
            <path d="M7 13a7 7 0 0 1 10 0M4 9a12 12 0 0 1 16 0M1 5a16 16 0 0 1 22 0"/>
          </svg>
        </button>
      </div>

      <!-- Pro Racer Lobby Footer Links & Studio Tags -->
      <div class="lobby-footer-bar">
        <div class="footer-links-group">
          <a href="privacy.html" target="_blank" rel="noopener noreferrer" class="footer-link-btn" id="btn-footer-privacy" title="Open Privacy Policy">
            <svg viewBox="0 0 24 24" width="13" height="13" style="stroke: currentColor; fill: none; stroke-width: 2; vertical-align: middle;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>Privacy Policy</span>
          </a>
          <span class="footer-dot">•</span>
          <a href="terms.html" target="_blank" rel="noopener noreferrer" class="footer-link-btn" id="btn-footer-terms" title="Open Terms of Service">
            <svg viewBox="0 0 24 24" width="13" height="13" style="stroke: currentColor; fill: none; stroke-width: 2; vertical-align: middle;"><path d="M12 3v18M5 8l7-4 7 4M5 8l-3 6h6L5 8zm14 0l-3 6h6l-3-6z"/></svg>
            <span>Terms of Service</span>
          </a>
          <span class="footer-dot">•</span>
          <button type="button" class="footer-link-btn" id="btn-footer-guide">
            <svg viewBox="0 0 24 24" width="13" height="13" style="stroke: currentColor; fill: none; stroke-width: 2; vertical-align: middle;"><rect x="2" y="6" width="20" height="12" rx="6"/><line x1="7" y1="12" x2="11" y2="12"/><line x1="9" y1="10" x2="9" y2="14"/><circle cx="16" cy="10.5" r="1"/><circle cx="18" cy="13.5" r="1"/></svg>
            <span>Controls & Tips</span>
          </button>
        </div>
        <div class="footer-badge-group">
          <span class="version-tag">v1.2 // PRO EDITION</span>
          <span class="footer-dot">•</span>
          <span class="studio-tag">AIRSKID.IO</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Fullscreen Arcade Mode Select Overlay (Yellow + White + Sky Blue Arcade Theme) -->
  <div id="mode-select-modal" class="mode-select-overlay" style="display: none;">
    <div class="mode-select-container">
      <!-- Header Bar with Back Button, Title, and Coins Display -->
      <div class="mode-select-header">
        <button type="button" class="mode-back-btn" id="btn-close-mode-select" title="Back to Garage Lobby">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>GARAGE</span>
        </button>

        <div class="mode-header-title-wrap">
          <div class="mode-header-badge">
            <span>AIRSKID GRAND PRIX</span>
          </div>
          <h2 class="mode-header-title">CHOOSE GAME MODE</h2>
        </div>

        <div class="mode-header-stats">
          <div class="mode-stat-pill">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="#F59E0B" stroke="#000" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6" fill="#FDE047"/>
            </svg>
            <span id="mode-select-coin-counter">0</span>
          </div>
        </div>
      </div>

      <!-- 4 Interactive Mode Cards Grid -->
      <div class="mode-cards-grid">
        <!-- Card 1: Solo Grand Prix -->
        <div class="mode-card card-grand-prix">
          <span class="mode-card-ribbon ribbon-yellow">RECOMMENDED</span>
          <div class="mode-visual-bubble bubble-yellow">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" fill="#FFE600"/>
              <line x1="4" y1="22" x2="4" y2="15"/>
            </svg>
          </div>
          <h3 class="mode-card-title">SOLO GRAND PRIX</h3>
          <span class="mode-card-tag tag-yellow">3 LAPS // 6 AI DRIVERS</span>
          <p class="mode-card-desc">Classic arcade cup! Race against tuned AI rivals, pick up weapons, drift for boost.</p>
          <ul class="mode-features-list">
            <li><span class="feat-check">✔</span> Dynamic Slipstream Draft</li>
            <li><span class="feat-check">✔</span> Nitro Boost & Weapon Boxes</li>
            <li><span class="feat-check">✔</span> Earn +150 Coins for Win</li>
          </ul>
          <button type="button" class="mode-action-btn btn-action-yellow" id="start-race-btn" title="Launch Solo Grand Prix">
            <span>RACE NOW</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#000"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>

        <!-- Card 2: Sky Rumble (Sumo Arena) -->
        <div class="mode-card card-rumble">
          <span class="mode-card-ribbon ribbon-cyan">BRAWL ARENA</span>
          <div class="mode-visual-bubble bubble-cyan">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l8 4v6c0 5-3.5 9.5-8 10.5C7.5 21.5 4 17 4 12V6l8-4z" fill="#00D2FF"/>
              <line x1="12" y1="6" x2="12" y2="18"/>
              <line x1="8" y1="10" x2="16" y2="14"/>
              <line x1="16" y1="10" x2="8" y2="14"/>
            </svg>
          </div>
          <h3 class="mode-card-title">SKY RUMBLE</h3>
          <span class="mode-card-tag tag-cyan">TDM & FFA SUMO ARENA</span>
          <p class="mode-card-desc">No track, pure battle! Knock rival karts off the sky platform with heavy bumpers.</p>
          <ul class="mode-features-list">
            <li><span class="feat-check">✔</span> Floating Sky Arena Ring</li>
            <li><span class="feat-check">✔</span> Team Cyan vs Team Crimson</li>
            <li><span class="feat-check">✔</span> Custom Kill & Time Goals</li>
          </ul>
          <button type="button" class="mode-action-btn btn-action-cyan" id="btn-open-rumble" title="Open Sky Rumble Setup">
            <span>ENTER BRAWL</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#000"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>

        <!-- Card 3: Online Multiplayer -->
        <div class="mode-card card-multiplayer">
          <span class="mode-card-ribbon ribbon-green">P2P LIVE</span>
          <div class="mode-visual-bubble bubble-green">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="18" r="2" fill="#10B981"/>
              <path d="M7 13a7 7 0 0 1 10 0M4 9a12 12 0 0 1 16 0M1 5a16 16 0 0 1 22 0"/>
            </svg>
          </div>
          <h3 class="mode-card-title">MULTIPLAYER</h3>
          <span class="mode-card-tag tag-green">P2P ROOM // UP TO 6 PLAYERS</span>
          <p class="mode-card-desc">Host a private lobby or join friends with room codes. Smooth 60 FPS peer sync.</p>
          <ul class="mode-features-list">
            <li><span class="feat-check">✔</span> Instant Room Link Sharing</li>
            <li><span class="feat-check">✔</span> WebRTC Peer-to-Peer</li>
            <li><span class="feat-check">✔</span> Live Player Roster & Ping</li>
          </ul>
          <button type="button" class="mode-action-btn btn-action-green" id="btn-open-mp" title="Create or Join Online Room">
            <span>HOST / JOIN</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#FFF"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>

        <!-- Card 4: Hardcore Gauntlet -->
        <div class="mode-card card-hardcore">
          <span class="mode-card-ribbon ribbon-red">EXPERT ONLY</span>
          <div class="mode-visual-bubble bubble-red">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a7 7 0 0 0-7 7c0 3 2 5.5 4 6.5V19h6v-2.5c2-1 4-3.5 4-6.5a7 7 0 0 0-7-7z" fill="#FF385C"/>
              <circle cx="9.5" cy="10.5" r="1.5" fill="#FFF"/>
              <circle cx="14.5" cy="10.5" r="1.5" fill="#FFF"/>
              <line x1="10" y1="15" x2="14" y2="15" stroke="#FFF" stroke-width="1.5"/>
            </svg>
          </div>
          <h3 class="mode-card-title">HARDCORE</h3>
          <span class="mode-card-tag tag-red">3X HAZARDS // EXTREME SPEED</span>
          <p class="mode-card-desc">For master pilots. High-speed chicanes, 3x oil slicks, dense bombs, zero respawn grace.</p>
          <ul class="mode-features-list">
            <li><span class="feat-check">✔</span> Turbocharged 150cc Physics</li>
            <li><span class="feat-check">✔</span> Dynamic Hazard Spawns</li>
            <li><span class="feat-check">✔</span> Double XP & Exclusive Trophies</li>
          </ul>
          <button type="button" class="mode-action-btn btn-action-red" id="start-hardcore-btn" title="Launch Hardcore Gauntlet">
            <span>CHALLENGE</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#FFF"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Fullscreen Dedicated Arcade Multiplayer Hub Section -->
  <div id="mp-modal" class="mode-select-overlay mp-hub-overlay" style="display: none;">
    <div class="mode-select-container mp-hub-container">
      
      <!-- Top Header Bar with Garage Back Button, Title, and Pilot Callsign -->
      <div class="mode-select-header mp-hub-header">
        <button type="button" class="mode-back-btn" id="btn-close-mp" title="Back to Garage Lobby">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>GARAGE</span>
        </button>

        <div class="mode-header-title-wrap">
          <div class="mode-header-badge mp-badge-live">
            <span class="mp-live-dot"></span>
            <span>ONLINE P2P // INSTANT LOBBIES</span>
          </div>
          <h2 class="mode-header-title">MULTIPLAYER HUB</h2>
        </div>

        <div class="mp-pilot-box" title="Your Callsign in Multiplayer Rooms">
          <span class="mp-pilot-icon">👤</span>
          <span class="mp-pilot-label">PILOT:</span>
          <input type="text" class="mp-pilot-input" id="mp-name-input" value="SPEEDSTER" maxlength="12" placeholder="YOUR NAME" />
        </div>
      </div>

      <!-- Main Dual-Deck: Left Host Mode Setup + Right Join Lobby -->
      <div class="mp-hub-main-deck" id="mp-options-grid">
        
        <!-- LEFT COLUMN: HOST A ROOM -->
        <div class="mp-host-column">
          <div class="mp-column-banner banner-yellow">
            <div class="mp-banner-left">
              <span class="mp-banner-num">1</span>
              <div>
                <h3 class="mp-banner-title">CREATE LOBBY & SELECT GAME MODE</h3>
                <p class="mp-banner-subtitle">Pick the match mode, configure rules, and generate your room code</p>
              </div>
            </div>
            <span class="mp-banner-pill">HOST SETUP</span>
          </div>

          <!-- 3 Mode Cards Grid for Multiplayer Host -->
          <div class="mp-mode-choices-grid">
            
            <!-- Mode 1: Classic Grand Prix -->
            <div class="mp-mode-card active" data-mode="classic" id="mp-card-classic">
              <span class="mp-card-badge badge-yellow">CIRCUIT CUP</span>
              <div class="mp-mode-icon-circle bg-yellow">
                <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <!-- Checkered Flag -->
                  <path d="M26 6 L42 10 L36 18 L24 14 Z" fill="#FFF" stroke="#000" stroke-width="2"/>
                  <rect x="30" y="8" width="4" height="4" fill="#000"/>
                  <rect x="34" y="12" width="4" height="4" fill="#000"/>
                  <line x1="24" y1="6" x2="24" y2="20" stroke="#000" stroke-width="2.5"/>
                  <!-- Turbo Kart -->
                  <path d="M6 34 L18 26 L36 24 L42 30 L10 38 Z" fill="#FFDE59" stroke="#000" stroke-width="2.5"/>
                  <rect x="4" y="32" width="8" height="12" rx="3" fill="#18181B" stroke="#000" stroke-width="2"/>
                  <rect x="32" y="28" width="10" height="14" rx="4" fill="#18181B" stroke="#000" stroke-width="2"/>
                  <circle cx="24" cy="22" r="5" fill="#FFF" stroke="#000" stroke-width="2"/>
                  <path d="M22 21 Q27 19 28 22" stroke="#00D2FF" stroke-width="2"/>
                  <!-- Speedlines -->
                  <line x1="2" y1="24" x2="14" y2="24" stroke="#F59E0B" stroke-width="2.5"/>
                  <line x1="4" y1="18" x2="18" y2="18" stroke="#F59E0B" stroke-width="2.5"/>
                </svg>
              </div>
              <h4 class="mp-card-name">CLASSIC GP</h4>
              <span class="mp-card-meta">CIRCUIT RACING</span>
              <p class="mp-card-blurb">Slipstream draft, drift turbo boosts, weapon boxes & lap checkpoints.</p>
              <div class="mp-card-active-check">SELECTED ✔</div>
            </div>

            <!-- Mode 2: Sky Rumble Arena -->
            <div class="mp-mode-card" data-mode="rumble" id="mp-card-rumble">
              <span class="mp-card-badge badge-cyan">SUMO ARENA</span>
              <div class="mp-mode-icon-circle bg-cyan">
                <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <!-- Floating Arena Ring -->
                  <ellipse cx="24" cy="38" rx="20" ry="7" fill="#E0F7FA" stroke="#000" stroke-width="2.5"/>
                  <!-- Left Cyan Kart -->
                  <path d="M8 26 L20 28 L16 34 L6 32 Z" fill="#00D2FF" stroke="#000" stroke-width="2.2"/>
                  <!-- Right Crimson Kart -->
                  <path d="M40 26 L28 28 L32 34 L42 32 Z" fill="#FF385C" stroke="#000" stroke-width="2.2"/>
                  <!-- Clash Impact Starburst -->
                  <polygon points="24,14 27,22 35,21 29,26 33,33 24,28 15,33 19,26 13,21 21,22" fill="#FFE600" stroke="#000" stroke-width="2"/>
                  <!-- Sparks -->
                  <circle cx="16" cy="12" r="2" fill="#FF385C"/>
                  <circle cx="32" cy="10" r="2" fill="#00D2FF"/>
                </svg>
              </div>
              <h4 class="mp-card-name">SKY RUMBLE</h4>
              <span class="mp-card-meta">KNOCKOUT BRAWL</span>
              <p class="mp-card-blurb">Floating arena clash! Smash rivals off the sky ring for team or solo points.</p>
              <div class="mp-card-active-check">SELECTED ✔</div>
            </div>

            <!-- Mode 3: Hardcore Sky Tour -->
            <div class="mp-mode-card" data-mode="hardcore" id="mp-card-hardcore">
              <span class="mp-card-badge badge-red">EXPERT ONLY</span>
              <div class="mp-mode-icon-circle bg-red">
                <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <!-- Twin Exhaust Nitro Flames -->
                  <path d="M6 34 Q2 26 8 20 Q12 28 8 36" fill="#FFDE59" stroke="#FF385C" stroke-width="2"/>
                  <path d="M42 34 Q46 26 40 20 Q36 28 40 36" fill="#FFDE59" stroke="#FF385C" stroke-width="2"/>
                  <!-- Chrome Skull Helmet -->
                  <ellipse cx="24" cy="22" rx="14" ry="13" fill="#FFF" stroke="#000" stroke-width="2.8"/>
                  <ellipse cx="19" cy="21" rx="3.5" ry="4.5" fill="#FF385C" stroke="#000" stroke-width="1.8"/>
                  <ellipse cx="29" cy="21" rx="3.5" ry="4.5" fill="#FF385C" stroke="#000" stroke-width="1.8"/>
                  <polygon points="24,25 22,29 26,29" fill="#000"/>
                  <rect x="18" y="32" width="12" height="5" rx="2" fill="#18181B" stroke="#000" stroke-width="1.8"/>
                  <line x1="22" y1="32" x2="22" y2="37" stroke="#FFF" stroke-width="1.5"/>
                  <line x1="26" y1="32" x2="26" y2="37" stroke="#FFF" stroke-width="1.5"/>
                  <polygon points="25,10 21,18 26,17 22,24 29,15 24,16" fill="#FFE600" stroke="#000" stroke-width="1.2"/>
                </svg>
              </div>
              <h4 class="mp-card-name">HARDCORE SKY</h4>
              <span class="mp-card-meta">EXTREME 150CC</span>
              <p class="mp-card-blurb">Zero guardrails, lethal sky falls, 3x dense bomb hazards & razor chicanes.</p>
              <div class="mp-card-active-check">SELECTED ✔</div>
            </div>

          </div>

          <!-- Mode Custom Settings Panel (Laps or Rumble Rules) -->
          <div class="mp-settings-deck">
            
            <!-- Settings for Classic & Hardcore (Laps) -->
            <div class="mp-setting-row" id="mp-laps-row">
              <div class="mp-setting-info">
                <span class="mp-setting-title">RACE LENGTH:</span>
                <span class="mp-setting-hint">Total laps to determine the race winner</span>
              </div>
              <div class="lap-select-group" id="lap-select-group">
                <button type="button" class="lap-choice-btn" data-laps="1">1 LAP</button>
                <button type="button" class="lap-choice-btn" data-laps="2">2 LAPS</button>
                <button type="button" class="lap-choice-btn active" data-laps="3">3 LAPS</button>
                <button type="button" class="lap-choice-btn" data-laps="5">5 LAPS</button>
              </div>
            </div>

            <!-- Settings for Sky Rumble (Format & Win Condition) -->
            <div class="mp-setting-row" id="mp-rumble-settings-row" style="display: none;">
              <div class="mp-rumble-subcontrols">
                <div class="mp-rumble-control-block">
                  <span class="mp-setting-title">MATCH FORMAT:</span>
                  <div class="mp-pill-selector" id="mp-rumble-format-selector">
                    <button type="button" class="mp-pill-opt active" data-format="tdm">TEAM DEATHMATCH (CYAN VS CRIMSON)</button>
                    <button type="button" class="mp-pill-opt" data-format="ffa">SOLO FREE FOR ALL</button>
                  </div>
                </div>
                <div class="mp-rumble-control-block">
                  <span class="mp-setting-title">WIN CONDITION:</span>
                  <div class="mp-pill-selector" id="mp-rumble-rule-selector">
                    <button type="button" class="mp-pill-opt active" data-rule="kills_10">10 KILLS</button>
                    <button type="button" class="mp-pill-opt" data-rule="kills_20">20 KILLS</button>
                    <button type="button" class="mp-pill-opt" data-rule="time_3m">3 MIN TIMER</button>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- Big Host CTA Button -->
          <button type="button" class="mp-hero-create-btn" id="btn-host-room">
            <span>★ CREATE MULTIPLAYER LOBBY ★</span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="#000"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>

        <!-- RIGHT COLUMN: JOIN ROOM -->
        <div class="mp-join-column">
          <div class="mp-column-banner banner-cyan">
            <div class="mp-banner-left">
              <span class="mp-banner-num">2</span>
              <div>
                <h3 class="mp-banner-title">JOIN WITH ROOM CODE</h3>
                <p class="mp-banner-subtitle">Enter code from your host friend</p>
              </div>
            </div>
            <span class="mp-banner-pill">QUICK JOIN</span>
          </div>

          <div class="mp-join-body-card">
            <div class="mp-join-icon-bubble">
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none">
                <circle cx="24" cy="24" r="21" fill="#FFDE59" stroke="#000" stroke-width="3"/>
                <path d="M14 16 C17 12 31 12 34 16" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M18 20 C20 17 28 17 30 20" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="24" cy="25" r="4.5" fill="#FF385C" stroke="#000" stroke-width="2"/>
                <circle cx="24" cy="25" r="1.5" fill="#FFF"/>
                <path d="M24 29.5 L24 38 M18 38 L30 38 M20 38 L24 31 L28 38" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="10,12 12,9 15,11 12,14" fill="#00D2FF" stroke="#000" stroke-width="1.2"/>
                <polygon points="38,12 36,9 33,11 36,14" fill="#00D2FF" stroke="#000" stroke-width="1.2"/>
              </svg>
            </div>
            <h4 class="mp-join-heading">GOT AN INVITE?</h4>
            <p class="mp-join-prompt">Type or paste the 4-digit room code below to instantly join your friend's room.</p>
            
            <div class="mp-input-wrap">
              <input type="text" class="mp-code-input" id="join-room-input" placeholder="AERO-XXXX" maxlength="12" spellcheck="false" autocomplete="off" />
            </div>

            <button type="button" class="mp-hero-join-btn" id="btn-join-room">
              <span>▶ JOIN LOBBY</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#000"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </button>

            <div class="mp-join-footer-tip">
              <span class="tip-star">✦</span>
              <span>Direct Link Support: Opening any link formatted like <code>?room=AERO-XXXX</code> connects automatically!</span>
            </div>
          </div>
        </div>

      </div>

      <!-- ACTIVE WAITING ROOM VIEW (Shown when lobby created or joined) -->
      <div id="lobby-view" class="mp-waiting-room-deck" style="display: none;">
        
        <!-- Waiting Room Top Information Strip -->
        <div class="mp-room-info-strip">
          <div class="mp-room-tags-group">
            <div class="mp-tag-unit">
              <span class="mp-tag-label">ROOM CODE:</span>
              <span class="mp-tag-value val-yellow" id="lobby-code-display">GENERATING...</span>
            </div>
            <div class="mp-tag-unit">
              <span class="mp-tag-label">GAME MODE:</span>
              <span class="mp-tag-value val-cyan" id="lobby-mode-display">🏎️ CLASSIC GRAND PRIX</span>
            </div>
            <div class="mp-tag-unit">
              <span class="mp-tag-label">MATCH RULE:</span>
              <span class="mp-tag-value val-white" id="lobby-laps-display">3 LAPS</span>
            </div>
          </div>

          <button type="button" class="mp-copy-link-btn" id="btn-copy-link" title="Copy Direct Invite Link to Clipboard">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#000" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>📋 COPY INVITE LINK</span>
          </button>
        </div>

        <!-- Waiting Room Racers Grid -->
        <div class="mp-roster-section">
          <div class="mp-roster-topbar">
            <div class="mp-roster-title">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#1e40af"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg>
              <span>CONNECTED RACERS IN STAGING</span>
            </div>
            <div class="mp-roster-counter">
              <span id="lobby-count">1</span> / 6 SLOTS OCCUPIED
            </div>
          </div>

          <div class="mp-roster-grid" id="lobby-player-list">
            <!-- Dynamically populated roster cards -->
          </div>
        </div>

        <!-- Waiting Room Action Buttons Bottom Bar -->
        <div class="mp-waiting-footer">
          <button type="button" class="mp-btn-leave" id="btn-leave-mp" title="Leave room and return to lobby setup">
            <span>✕ LEAVE ROOM</span>
          </button>
          
          <button type="button" class="mp-btn-launch" id="btn-start-multiplayer">
            <span>🚀 LAUNCH MULTIPLAYER MATCH</span>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="#000"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>

      </div>

    </div>
  </div>

  <!-- Centered Sky Rumble Settings Modal -->
  <div id="rumble-modal" style="display: none;" class="modal-overlay">
    <div class="mp-popup-card rumble-modal-card" style="max-width: 530px;">
      <div class="mp-modal-top" style="border-bottom: 1.5px solid rgba(0, 240, 255, 0.3);">
        <div class="mp-modal-badge" style="background: linear-gradient(135deg, #ff0055 0%, #ff5500 100%); color: #fff; border: none; box-shadow: 0 0 15px rgba(255, 0, 85, 0.5);">
          <span>⚔️</span>
          <span>SKY RUMBLE // ARENA CLASH</span>
        </div>
        <button type="button" class="mp-close-btn" id="btn-close-rumble" title="Back to Garage" style="background: #141b29; color: #fff; border-color: rgba(255,255,255,0.2);">✕</button>
      </div>

      <!-- Mode Format: 2 Teams TDM vs Solo FFA -->
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span style="font-size: 11px; font-weight: 900; color: #00f0ff; letter-spacing: 1.5px;">1. MATCH FORMAT:</span>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <button type="button" class="rumble-format-btn active" data-format="tdm" style="padding: 10px 8px; font-size: 13px;">
            <span>TEAM DEATHMATCH</span>
          </button>
          <button type="button" class="rumble-format-btn" data-format="ffa" style="padding: 10px 8px; font-size: 13px;">
            <span>SOLO FREE FOR ALL</span>
          </button>
        </div>
      </div>

      <!-- Team Choice (if TDM) -->
      <div id="rumble-team-select-row" style="display: flex; flex-direction: column; gap: 6px;">
        <span style="font-size: 11px; font-weight: 900; color: #00f0ff; letter-spacing: 1.5px;">2. CHOOSE YOUR SIDE:</span>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <button type="button" class="rumble-side-btn active" data-side="cyan" style="font-size: 13px; padding: 10px;">
            TEAM CYAN (NORTH)
          </button>
          <button type="button" class="rumble-side-btn" data-side="crimson" style="font-size: 13px; padding: 10px;">
            TEAM CRIMSON (SOUTH)
          </button>
        </div>
      </div>

      <!-- Win Conditions -->
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span style="font-size: 11px; font-weight: 900; color: #00f0ff; letter-spacing: 1.5px;">3. WIN RULE / GOAL:</span>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
          <button type="button" class="rumble-rule-btn active" data-rule="kills_10" style="padding: 9px 4px; font-size: 11px;">
            🎯 10 KILLS
          </button>
          <button type="button" class="rumble-rule-btn" data-rule="kills_20" style="padding: 9px 4px; font-size: 11px;">
            🎯 20 KILLS
          </button>
          <button type="button" class="rumble-rule-btn" data-rule="kills_30" style="padding: 9px 4px; font-size: 11px;">
            🎯 30 KILLS
          </button>
          <button type="button" class="rumble-rule-btn" data-rule="time_3min" style="padding: 9px 4px; font-size: 11px;">
            ⏱️ 3 MINUTES
          </button>
          <button type="button" class="rumble-rule-btn" data-rule="time_5min" style="padding: 9px 4px; font-size: 11px;">
            ⏱️ 5 MINUTES
          </button>
          <button type="button" class="rumble-rule-btn" data-rule="lives_3" style="padding: 9px 4px; font-size: 11px;">
            ❤️ 3 LIVES
          </button>
        </div>
      </div>

      <!-- Enter Arena CTA Button -->
      <button type="button" class="btn-rumble-cta" id="btn-start-rumble-match" style="font-size: 18px; padding: 15px; margin-top: 6px; letter-spacing: 2px;">
        ⚔️ ENTER ARENA BRAWL ⚔️
      </button>
    </div>
  </div>

  <!-- Finish Leaderboard Modal -->
  <div class="modal-overlay" id="finish-modal" style="display: none;">
    <div class="menu-card">
      <div class="game-logo-badge" style="background: var(--brut-yellow);">
        <h1 class="game-logo" id="finish-title">RACE FINISHED</h1>
      </div>
      <p id="finish-subtext" style="font-size: 16px; color: #333; font-weight: 800;"></p>

      <table class="results-table" id="results-table">
        <thead>
          <tr>
            <th>POS</th>
            <th>RACER</th>
            <th>KART</th>
            <th>TIME</th>
          </tr>
        </thead>
        <tbody id="results-body">
          <!-- Populated dynamically -->
        </tbody>
      </table>

      <!-- Finish Coin & XP Reward Banner -->
      <div id="finish-rewards-box" style="display: flex; align-items: center; justify-content: center; gap: 16px; background: #FFF9D2; border: 2.5px solid #000; box-shadow: 3px 3px 0 #000; border-radius: 14px; padding: 8px 16px; margin: 4px 0;">
        <div style="display: flex; align-items: center; gap: 6px; font-family: var(--font-display); font-size: 15px; font-weight: 900; color: #000;">
          <span>🪙</span> <span id="finish-coins-earned">+150 COINS</span>
        </div>
        <div style="width: 2px; height: 18px; background: #000;"></div>
        <div style="display: flex; align-items: center; gap: 6px; font-family: var(--font-display); font-size: 15px; font-weight: 900; color: #1e40af;">
          <span>⭐</span> <span id="finish-xp-earned">+80 XP</span>
        </div>
      </div>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <button class="brut-btn btn-yellow" id="restart-btn" style="font-size: 20px; padding: 12px 28px;">PLAY AGAIN</button>
        <button class="brut-btn btn-white" id="change-kart-btn" style="font-size: 16px;">SELECT KART</button>
      </div>
    </div>
  </div>


  <!-- Controls & Tips / How to Play Modal -->
  <div id="guide-modal" style="display: none;" class="modal-overlay">
    <div class="policy-card" style="max-width: 580px;">
      <div class="mp-modal-top">
        <div class="mp-modal-badge" style="background: #a78bfa; color: #000;">
          <span>🎮</span>
          <span>HOW TO PLAY & CONTROLS</span>
        </div>
        <button type="button" class="mp-close-btn" id="btn-close-guide">✕</button>
      </div>
      <div class="policy-content-scroll">
        <div class="controls-grid">
          <div class="ctrl-card">
            <span class="ctrl-key-badge">W / ↑</span>
            <span class="ctrl-desc">Accelerate / Drive Forward</span>
          </div>
          <div class="ctrl-card">
            <span class="ctrl-key-badge">S / ↓</span>
            <span class="ctrl-desc">Reverse / Brake</span>
          </div>
          <div class="ctrl-card">
            <span class="ctrl-key-badge">A / D or ← / →</span>
            <span class="ctrl-desc">Steer Left & Right</span>
          </div>
          <div class="ctrl-card">
            <span class="ctrl-key-badge">SHIFT / SPACE</span>
            <span class="ctrl-desc">Drift for Boost Sparks 🔥</span>
          </div>
          <div class="ctrl-card">
            <span class="ctrl-key-badge">E / ALT</span>
            <span class="ctrl-desc">Fire Nitro Boost 🚀</span>
          </div>
          <div class="ctrl-card">
            <span class="ctrl-key-badge">R</span>
            <span class="ctrl-desc">Quick Respawn to Track</span>
          </div>
        </div>
        <div class="policy-section" style="margin-top: 4px;">
          <h4>💡 PRO RACER TIPS</h4>
          <p>• <strong>Sky Smash Ramming:</strong> Ram opponents at high speed or during Nitro to launch them skyward!<br/>
• <strong>Drift Sparks:</strong> Hold drift through curves to build blue and orange flame sparks for a mini-turbo boost when released.<br/>
• <strong>Coins & Loot:</strong> Earn Coins and XP by scoring Sky Smashes, finishing laps, and unlocking your Daily Free Crate.</p>
        </div>
      </div>
      <button type="button" class="brut-btn btn-yellow" id="btn-accept-guide" style="font-size: 14px; padding: 10px; width: 100%;">
        READY TO HIT THE TRACK! 🏎️
      </button>
    </div>
  </div>

  <!-- Daily Reward / Chest Loot Modal -->
  <div id="rewards-modal" style="display: none;" class="modal-overlay">
    <div class="policy-card gift-chest-card">
      <div class="mp-modal-top">
        <div class="mp-modal-badge" style="background: #FF385C; color: #FFF;">
          <span>🎁</span>
          <span>DAILY LOOT CHEST</span>
        </div>
        <button type="button" class="mp-close-btn" id="btn-close-rewards">✕</button>
      </div>
      <div class="chest-center-visual">
        <div class="chest-bouncing-icon" id="chest-icon-anim">📦</div>
        <div class="chest-title" id="rewards-modal-title">DAILY MYSTERY CRATE</div>
        <div class="chest-desc" id="rewards-modal-desc">
          Claim your free daily mystery loot crate to get Coins & Gems for your garage!
        </div>
        <div class="reward-loot-row" id="loot-reward-prizes">
          <div class="loot-item">
            <span style="font-size: 28px;">🪙</span>
            <span class="loot-qty" style="font-family: var(--font-display); font-size: 18px; font-weight: 900; color: #000;">+250</span>
            <span class="loot-label" style="font-size: 10px; font-weight: 800; color: #555;">COINS</span>
          </div>
          <div class="loot-item">
            <span style="font-size: 28px;">💎</span>
            <span class="loot-qty" style="font-family: var(--font-display); font-size: 18px; font-weight: 900; color: #0088cc;">+15</span>
            <span class="loot-label" style="font-size: 10px; font-weight: 800; color: #555;">GEMS</span>
          </div>
          <div class="loot-item">
            <span style="font-size: 28px;">⭐</span>
            <span class="loot-qty" style="font-family: var(--font-display); font-size: 18px; font-weight: 900; color: #e11d48;">+50</span>
            <span class="loot-label" style="font-size: 10px; font-weight: 800; color: #555;">RACER XP</span>
          </div>
        </div>
      </div>
      <button type="button" class="brut-btn btn-yellow" id="btn-claim-loot" style="font-size: 16px; padding: 12px; width: 100%; letter-spacing: 1px;">
        🎉 OPEN CRATE & CLAIM 🎉
      </button>
    </div>
  </div>

  <script type="module" src="/src/main.ts"></script>
</body>
</html>
